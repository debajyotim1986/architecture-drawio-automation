<mxfile host="app.diagrams.net" modified="2026-09-08T00:00:00.000Z" agent="architecture-doc" version="24.0.0" type="device">
  <diagram id="looker-seq" name="External Looker Access — Sequence (16 steps)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1210" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="External User → Looker Dashboard — Sequence View (final flow, 16 steps)" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#1C2733;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="34" as="geometry" />
        </mxCell>

        <!-- ================= PARTICIPANTS ================= -->
        <mxCell id="p1" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;(external user)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1C2733;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="140" height="54" as="geometry" /></mxCell>
        <mxCell id="p2" value="&lt;b&gt;Front Door&lt;/b&gt;&lt;br&gt;Ext HTTPS LB + Apigee external proxy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F1F8;strokeColor=#0B5FA5;strokeWidth=2;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="200" y="70" width="140" height="54" as="geometry" /></mxCell>
        <mxCell id="p3" value="&lt;b&gt;UI App&lt;/b&gt;&lt;br&gt;hosted in GKE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6EF;strokeColor=#1A7F4E;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="70" width="140" height="54" as="geometry" /></mxCell>
        <mxCell id="p4" value="&lt;b&gt;Apigee&lt;/b&gt;&lt;br&gt;INTERNAL proxy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F1F8;strokeColor=#0B5FA5;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="70" width="140" height="54" as="geometry" /></mxCell>
        <mxCell id="p5" value="&lt;b&gt;ID&amp;amp;A API&lt;/b&gt;&lt;br&gt;identity team" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4ECF8;strokeColor=#8E6AA8;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="70" width="140" height="54" as="geometry" /></mxCell>
        <mxCell id="p6" value="&lt;b&gt;OSIS DB&lt;/b&gt;&lt;br&gt;credential store" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="850" y="62" width="120" height="66" as="geometry" /></mxCell>
        <mxCell id="p7" value="&lt;b&gt;GKE Data API&lt;/b&gt;&lt;br&gt;backend microservice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6EF;strokeColor=#1A7F4E;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="70" width="140" height="54" as="geometry" /></mxCell>
        <mxCell id="p8" value="&lt;b&gt;Looker&lt;/b&gt;&lt;br&gt;via reverse proxy (GKE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6EF;strokeColor=#1A7F4E;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="70" width="140" height="54" as="geometry" /></mxCell>
        <mxCell id="p9" value="&lt;b&gt;Data Warehouse&lt;/b&gt;&lt;br&gt;BigQuery / Cloud SQL" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="1330" y="62" width="120" height="66" as="geometry" /></mxCell>

        <!-- ================= LIFELINES ================= -->
        <mxCell id="ll1" style="endArrow=none;dashed=1;strokeColor=#B0BAC4;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="128" as="sourcePoint" /><mxPoint x="110" y="960" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ll2" style="endArrow=none;dashed=1;strokeColor=#B0BAC4;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="128" as="sourcePoint" /><mxPoint x="270" y="960" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ll3" style="endArrow=none;dashed=1;strokeColor=#B0BAC4;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="430" y="128" as="sourcePoint" /><mxPoint x="430" y="960" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ll4" style="endArrow=none;dashed=1;strokeColor=#B0BAC4;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="128" as="sourcePoint" /><mxPoint x="590" y="960" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ll5" style="endArrow=none;dashed=1;strokeColor=#B0BAC4;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="128" as="sourcePoint" /><mxPoint x="750" y="960" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ll6" style="endArrow=none;dashed=1;strokeColor=#B0BAC4;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="128" as="sourcePoint" /><mxPoint x="910" y="960" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ll7" style="endArrow=none;dashed=1;strokeColor=#B0BAC4;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="128" as="sourcePoint" /><mxPoint x="1070" y="960" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ll8" style="endArrow=none;dashed=1;strokeColor=#B0BAC4;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1230" y="128" as="sourcePoint" /><mxPoint x="1230" y="960" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ll9" style="endArrow=none;dashed=1;strokeColor=#B0BAC4;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1390" y="128" as="sourcePoint" /><mxPoint x="1390" y="960" as="targetPoint" /></mxGeometry></mxCell>

        <!-- ================= MESSAGES ================= -->
        <mxCell id="m1" value="1. opens the portal link (HTTPS)" style="html=1;strokeColor=#1C2733;strokeWidth=1.6;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="170" as="sourcePoint" /><mxPoint x="270" y="170" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" value="2. routes /login to the UI app" style="html=1;strokeColor=#1C2733;strokeWidth=1.6;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="214" as="sourcePoint" /><mxPoint x="430" y="214" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m3" value="3. login page shown in the browser" style="html=1;strokeColor=#1C2733;strokeWidth=1.6;dashed=1;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="430" y="258" as="sourcePoint" /><mxPoint x="110" y="258" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m4" value="4. userid + password submitted — the only manual action (TLS)" style="html=1;strokeColor=#1C2733;strokeWidth=1.6;fontSize=11;fontStyle=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="302" as="sourcePoint" /><mxPoint x="270" y="302" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m5" value="5. SpikeArrest + threat checks ✔ → submit forwarded" style="html=1;strokeColor=#0B5FA5;strokeWidth=1.6;fontSize=11;fontColor=#0B5FA5;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="346" as="sourcePoint" /><mxPoint x="430" y="346" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m6" value="6. credentials → INTERNAL proxy (never on the internet)" style="html=1;strokeColor=#0B5FA5;strokeWidth=1.6;fontSize=11;fontColor=#0B5FA5;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="430" y="390" as="sourcePoint" /><mxPoint x="590" y="390" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m7" value="7. calls the ID&amp;A API to validate" style="html=1;strokeColor=#0B5FA5;strokeWidth=1.6;fontSize=11;fontColor=#0B5FA5;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="434" as="sourcePoint" /><mxPoint x="750" y="434" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m8" value="8. check userid + password" style="html=1;strokeColor=#D79B00;strokeWidth=1.6;fontSize=11;fontColor=#9A5B00;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="478" as="sourcePoint" /><mxPoint x="910" y="478" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m9" value="✔ match" style="html=1;strokeColor=#D79B00;strokeWidth=1.6;dashed=1;fontSize=11;fontColor=#9A5B00;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="520" as="sourcePoint" /><mxPoint x="750" y="520" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m10" value="9–10. signed JWT created → back to Apigee (no browser detour)" style="html=1;strokeColor=#1A7F4E;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1A7F4E;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="564" as="sourcePoint" /><mxPoint x="270" y="564" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="n11" value="&lt;b&gt;11. VerifyJWT ✔&lt;/b&gt; — signature + expiry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F1F8;strokeColor=#0B5FA5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="180" y="596" width="180" height="34" as="geometry" /></mxCell>
        <mxCell id="m12" value="12. Authorization: Bearer &amp;lt;JWT&amp;gt; + user/tenant headers — private network (PSC · mTLS)" style="html=1;strokeColor=#0B5FA5;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#0B5FA5;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="672" as="sourcePoint" /><mxPoint x="1070" y="672" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="n13" value="&lt;b&gt;13. re-validates the JWT&lt;/b&gt; — defense in depth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6EF;strokeColor=#1A7F4E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="975" y="700" width="190" height="34" as="geometry" /></mxCell>
        <mxCell id="n14" value="&lt;b&gt;14. data scope&lt;/b&gt; — which dashboards / tenant rows + Signed SSO Embed URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6EF;strokeColor=#1A7F4E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="955" y="744" width="230" height="44" as="geometry" /></mxCell>
        <mxCell id="m15" value="15. via reverse proxy — row-level security applied" style="html=1;strokeColor=#1C2733;strokeWidth=1.6;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="830" as="sourcePoint" /><mxPoint x="1230" y="830" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m15b" value="query — only this user's rows (private IP)" style="html=1;strokeColor=#D79B00;strokeWidth=1.6;fontSize=11;fontColor=#9A5B00;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1230" y="874" as="sourcePoint" /><mxPoint x="1390" y="874" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m16" value="16. dashboard rendered back to the browser — HttpOnly cookie set on the response" style="html=1;strokeColor=#1A7F4E;strokeWidth=2.5;dashed=1;fontSize=11;fontStyle=1;fontColor=#1A7F4E;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1230" y="930" as="sourcePoint" /><mxPoint x="110" y="930" as="targetPoint" /></mxGeometry></mxCell>

        <!-- ================= NOTES ================= -->
        <mxCell id="noteAlt" value="&lt;b&gt;B. Alternate entry — External Application:&lt;/b&gt; a system that already holds a JWT calls /api/** through the &lt;b&gt;same Front Door&lt;/b&gt; and joins at step 11 (steps 1–10 skipped). It can never call the GKE API directly — GKE only accepts traffic from Apigee." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E8;strokeColor=#9A5B00;fontSize=12;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="990" width="1410" height="54" as="geometry" />
        </mxCell>
        <mxCell id="noteAfter" value="&lt;b&gt;Later requests&lt;/b&gt; (filters, drill-downs, next dashboards): the browser sends the cookie → only steps 11–16 repeat. The password travels once (steps 4–8) per login; when the token expires, the user logs in again." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EE;strokeColor=#1A7F4E;fontSize=12;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1058" width="1410" height="54" as="geometry" />
        </mxCell>
        <mxCell id="noteZone" value="&lt;b&gt;Trust note:&lt;/b&gt; only the Front Door faces the internet. UI App, internal proxy, ID&amp;A, OSIS, GKE API, Looker and the warehouse are all private." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3EEF7;strokeColor=#0B5FA5;fontSize=12;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1126" width="1410" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
