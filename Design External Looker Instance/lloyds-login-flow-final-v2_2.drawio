        <mxCell id="pilb" value="Internal LB / PSC&#10;cross-project entry&#10;exposes reverse proxy" style="shape=mxgraph.gcp2.hexIcon;prIcon=cloud_load_balancing;fillColor=#4284F3;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
