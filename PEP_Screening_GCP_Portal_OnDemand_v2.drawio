        <mxCell id="y19" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="f6" target="f7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="910" y="1335"/><mxPoint x="910" y="1050"/></Array></mxGeometry></mxCell>
        <mxCell id="y20" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="f7" target="f8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="y21" value="promote adapterVer (loop)" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="f8" target="i3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1400" y="1190"/><mxPoint x="1400" y="330"/></Array></mxGeometry></mxCell>
        <mxCell id="y22" value="send-back notes" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="f1" target="f9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="970"/><mxPoint x="1115" y="970"/></Array></mxGeometry></mxCell>
        <mxCell id="y23" value="promptVer update (loop)" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="f9" target="i2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1430" y="1350"/><mxPoint x="1430" y="210"/></Array></mxGeometry></mxCell>
        <mxCell id="y24" value="calibVer / bandVer update (loop)" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="f10" target="i6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="60" y="1485"/><mxPoint x="60" y="430"/></Array></mxGeometry></mxCell>
        <mxCell id="y25" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="f11" target="f3"><mxGeometry relative="1" as="geometry"/></mxCell>
