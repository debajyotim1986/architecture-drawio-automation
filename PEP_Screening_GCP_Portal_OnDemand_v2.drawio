<mxfile host="app.diagrams.net" modified="2026-09-18T13:00:00.000Z" agent="Claude" version="24.0" type="device">
  <diagram id="p0" name="0 - Portal-triggered on-demand flow (GCP)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1250" pageHeight="1750">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <mxCell id="t0" value="PEP screening on GCP — ON-DEMAND: online payments land via Pub/Sub, portal holds pending cases, L0/L1 clicks Validate → full pipeline runs for that case" style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1150" height="30" as="geometry"/></mxCell>

        <mxCell id="a1" value="Online payment transaction&#10;details published to Pub/Sub&#10;topic: payments.completed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="80" y="80" width="240" height="70" as="geometry"/></mxCell>

        <mxCell id="a2" value="Case intake — Cloud Run (push subscription)&#10;validate + unpack event; dedupe: one OPEN case per&#10;customerId+kycVersion (upsert); PRE-CHECK register:&#10;fresh prior flag → case auto-labelled ALREADY EVALUATED&#10;(prior flag shown, no Validate needed); else status=PENDING&#10;→ insert into screening_case (AlloyDB) + portal feed (Firestore)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="400" y="70" width="400" height="130" as="geometry"/></mxCell>

        <mxCell id="a3" value="Optional pre-warm (async, cheap)&#10;on intake, fire-and-forget data acquisition into&#10;Memorystore/GCS cache so click-time run is fast;&#10;strictly optional — pipeline works without it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="880" y="90" width="300" height="90" as="geometry"/></mxCell>

        <mxCell id="p1" value="VALIDATION WEB PORTAL — Cloud Run frontend, IAP + IAM (L0/L1 group), CSP/audit logging&#10;work queue: pending cases w/ payment details, customer summary, ALREADY-EVALUATED badge where applicable;&#10;filters, claim/assign, SLA age; case detail page has the VALIDATE button" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1" vertex="1" parent="1"><mxGeometry x="200" y="250" width="800" height="90" as="geometry"/></mxCell>

        <mxCell id="d0" value="L0/L1 clicks&#10;VALIDATE" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="520" y="380" width="160" height="80" as="geometry"/></mxCell>

        <mxCell id="o1" value="Screening API — Cloud Run&#10;POST /cases/{id}/validate (idempotent: if a run is already&#10;active for the case, attach to it, never start a second);&#10;starts orchestrator execution; returns runId; status&#10;streamed to portal via Firestore listener (live step ticker)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="400" y="500" width="400" height="100" as="geometry"/></mxCell>

        <mxCell id="o2" value="Per-case orchestrator run — Temporal on GKE (or LangGraph/ADK&#10;graph, deterministic edges); per-step retry backoff+jitter, timeouts,&#10;compensation; latency budget ~60–120s end-to-end; each step&#10;completion → Firestore status doc (reviewer watches progress);&#10;failure → screening.failed DLQ + alert + Retry button in portal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="370" y="640" width="460" height="110" as="geometry"/></mxCell>

        <mxCell id="s1" value="1. Register re-check (race guard)&#10;bloom → Memorystore → AlloyDB;&#10;fresh flag appeared since intake →&#10;short-circuit, show prior result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="800" width="260" height="90" as="geometry"/></mxCell>

        <mxCell id="s2" value="2. Data acquisition fan-out&#10;Mosaic, Pega/CLM, EDH, Bridger, KYC +&#10;yente, Wikidata, role index (page 1);&#10;pre-warm cache hit if intake warmed it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="800" width="270" height="90" as="geometry"/></mxCell>

        <mxCell id="s3" value="3. Entity resolution (raw data, trusted zone)&#10;→ feature vector + evidence pack&#10;(GCS + BQ index) — no DLP here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="690" y="800" width="260" height="90" as="geometry"/></mxCell>

        <mxCell id="s4" value="4. Rules service — Cloud Run&#10;pandas + rapidfuzz, versioned rules module&#10;(rulesetVer audited); hard discounts fuzzy/DOB/geo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="930" width="260" height="80" as="geometry"/></mxCell>

        <mxCell id="s5" value="5. DLP tokenise SURVIVORS ONLY (model boundary)&#10;→ SLM scoring — Qwen3-8B on GKE vLLM&#10;(min replicas &gt; 0); self-consistency + JSON repair;&#10;gray zone → 6. Gemini ReAct loop (bounded)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="380" y="930" width="270" height="90" as="geometry"/></mxCell>

        <mxCell id="s6b" value="6. LLM escalation — Gemini ReAct loop (gray zone only)&#10;PLAN → TOOL → ACT → OBSERVE, max 6 iterations,&#10;allow-listed tools; critic pass on rationale;&#10;full tool trace → BQ (detail: page 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="80" y="1070" width="270" height="100" as="geometry"/></mxCell>
        <mxCell id="s6" value="7. Result assembly&#10;final score + binary recommendation +&#10;structured rationale + per-item evidence&#10;links + conflict markers → back to portal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="690" y="930" width="260" height="90" as="geometry"/></mxCell>

        <mxCell id="h1" value="SAME SCREEN, SAME PERSON — HITL decision&#10;portal shows score, recommendation, evidence, drafted rationale;&#10;reviewer: CONFIRM / OVERRIDE (+mandatory reason) / SEND-BACK&#10;(re-runs research tier with reviewer note); decision is the ONLY&#10;path to a register write" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1"><mxGeometry x="370" y="1070" width="460" height="110" as="geometry"/></mxCell>

        <mxCell id="w1" value="Register write (post sign-off only)&#10;AlloyDB pep_register upsert + BQ append-only audit (reviewer id,&#10;decision, modelVer, promptVer, patternVer, tool trace ref);&#10;Memorystore invalidate + bloom mark; case status=CLOSED;&#10;result event → Pub/Sub pep.screening.results" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="370" y="1220" width="460" height="100" as="geometry"/></mxCell>

        <mxCell id="m1" value="Observability&#10;click-to-result latency (p50/p95), queue age,&#10;override rate, send-back rate, DLQ age,&#10;cost per validated case" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="900" y="1230" width="280" height="90" as="geometry"/></mxCell>

        <mxCell id="ee19" value="gray zone" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="s5" target="s6b"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="360" y="1030"/><mxPoint x="360" y="1120"/></Array></mxGeometry></mxCell>
        <mxCell id="ee20" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="s6b" target="s6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="215" y="1200"/><mxPoint x="900" y="1200"/><mxPoint x="900" y="1050"/></Array></mxGeometry></mxCell>
        <mxCell id="ee1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee2" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="a2" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee4" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="p1" target="d0"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee5" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="d0" target="o1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee6" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="o1" target="o2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee7" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="o2" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee8" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee9" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee10" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="820" y="910"/><mxPoint x="210" y="910"/></Array></mxGeometry></mxCell>
        <mxCell id="ee11" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee12" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee13" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="s6" target="h1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee14" value="sign-off" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="h1" target="w1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee15" value="send-back (loop)" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="h1" target="s5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="1125"/><mxPoint x="300" y="975"/></Array></mxGeometry></mxCell>
        <mxCell id="ee16" value="short-circuit: prior flag" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="s1" target="h1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="60" y="845"/><mxPoint x="60" y="1125"/></Array></mxGeometry></mxCell>
        <mxCell id="ee17" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="w1" target="m1"><mxGeometry relative="1" as="geometry"/></mxCell>
