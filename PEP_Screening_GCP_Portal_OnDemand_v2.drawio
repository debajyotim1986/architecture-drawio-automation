      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="p1" name="1 - Data acquisition harness (GCP)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="1100">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <mxCell id="h0" value="Data acquisition on GCP — Cloud Run adapters, per-adapter resilience, Memorystore caching, VPC-SC + Private Service Connect to on-prem" style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="30" as="geometry"/></mxCell>

        <mxCell id="a0" value="Fan-out coordinator (Cloud Workflows parallel branches)&#10;per-source SLA budget; quorum policy: proceed when mandatory sources (EDH + Bridger) OK;&#10;results gathered into evidence envelope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="460" y="70" width="480" height="70" as="geometry"/></mxCell>

        <mxCell id="lane1" value="INTERNAL DATA PLANE — via Private Service Connect / Interconnect to bank systems (identified PII allowed)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="660" height="640" as="geometry"/></mxCell>

        <mxCell id="m1" value="Mosaic adapter — Cloud Run&#10;transaction history, counterparties, associated-person /&#10;linked-account graph → PEP-by-association evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="90" y="230" width="280" height="70" as="geometry"/></mxCell>

        <mxCell id="m2" value="Pega/CLM adapter — Cloud Run&#10;prior L0/L1 cases, closure codes, past rationale refs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="90" y="320" width="280" height="60" as="geometry"/></mxCell>

        <mxCell id="m3" value="EDH adapter — Cloud Run&#10;legal name, DOB, nationality, address, kycVersion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="90" y="400" width="280" height="60" as="geometry"/></mxCell>

        <mxCell id="m4" value="Bridger/LexisNexis adapter — Cloud Run&#10;existing paid watchlist feed (avoid duplication)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="90" y="480" width="280" height="60" as="geometry"/></mxCell>

        <mxCell id="m5" value="KYC profile adapter — Cloud Run&#10;occupation, employer, source-of-wealth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="90" y="560" width="280" height="60" as="geometry"/></mxCell>

        <mxCell id="res1" value="Resilience wrapper (every adapter)&#10;• timeout budget per call&#10;• retry: exp backoff + jitter, max 3&#10;• circuit breaker (5 fails → open, 30s probe)&#10;• token-bucket rate limiter&#10;• Memorystore response cache&#10;  (Mosaic 1h / EDH 24h / Bridger 15m)&#10;• normaliser → canonical EvidenceItem&#10;• Secret Manager for upstream creds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="410" y="230" width="290" height="200" as="geometry"/></mxCell>

        <mxCell id="res2" value="Failure loop&#10;breaker OPEN / retries exhausted → source&#10;DEGRADED, continue on quorum; Cloud Tasks&#10;backfill job loops back on recovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="410" y="460" width="290" height="90" as="geometry"/></mxCell>

        <mxCell id="tok" value="Cloud DLP de-identification boundary&#10;deterministic FPE tokenisation of PII before&#10;anything crosses to model/scoring zone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="410" y="590" width="290" height="80" as="geometry"/></mxCell>

        <mxCell id="lane2" value="EXTERNAL / OPEN DATA PLANE — near-zero cost, approved sources only (see page 2 for scraper + parser detail)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="760" y="180" width="600" height="640" as="geometry"/></mxCell>

        <mxCell id="x1" value="yente (OpenSanctions) — Cloud Run + local index&#10;/match API, per-property scoring; dataset delta-sync&#10;nightly via Cloud Scheduler + Cloud Run job" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="790" y="230" width="290" height="80" as="geometry"/></mxCell>

        <mxCell id="x3" value="Wikidata adapter — Cloud Run&#10;SPARQL: P39 position-held, family relations,&#10;term dates → association graph" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="790" y="330" width="290" height="70" as="geometry"/></mxCell>

        <mxCell id="x4" value="Official-source role index (BigQuery + AlloyDB)&#10;populated by the scraper/parser pipeline on page 2&#10;— queried here read-only, never scraped on-the-fly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="790" y="420" width="290" height="70" as="geometry"/></mxCell>

        <mxCell id="x5" value="Source allow-list registry (Firestore)&#10;approved domains + per-source parse contract;&#10;URL, access ts, extracted fact stored (traceability)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1100" y="330" width="250" height="80" as="geometry"/></mxCell>

        <mxCell id="x6" value="External response cache (Memorystore)&#10;Wikidata 7d, yente 24h, negative-result 24h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1100" y="440" width="250" height="60" as="geometry"/></mxCell>

        <mxCell id="agg" value="Evidence aggregator — Cloud Run&#10;merge EvidenceItems w/ provenance + conflict markers (e.g. DOB disagreement)&#10;→ GCS evidence packs + BigQuery evidence index → entity resolution (page 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="460" y="880" width="480" height="80" as="geometry"/></mxCell>

        <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="a0" target="m1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="a0" target="x1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="m1" target="res1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f4" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="res1" target="res2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f5" value="recovered" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="res2" target="a0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="740" y="505"/><mxPoint x="740" y="105"/></Array></mxGeometry></mxCell>
        <mxCell id="f7" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="x5" target="x3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f8" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="x6" target="x1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1090" y="470"/><mxPoint x="1090" y="285"/></Array></mxGeometry></mxCell>
        <mxCell id="f9" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="m5" target="tok"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f10" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="tok" target="agg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f11" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="x4" target="agg"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="850" as="targetPoint"/></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="p2" name="2 - Scraper + parsing pipeline (regex engine)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="1250">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <mxCell id="s0" value="Official-source scraper + parsing pipeline (scheduled, never in the payment path) — with RE2 regex engine and quarantine loop" style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="30" as="geometry"/></mxCell>

        <mxCell id="c1" value="Cloud Scheduler&#10;per-source cron (daily gazettes,&#10;weekly parliament lists, monthly registries)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="100" y="80" width="260" height="70" as="geometry"/></mxCell>

        <mxCell id="c2" value="Crawler — Cloud Run Jobs (per-source config)&#10;robots.txt compliance, polite rate limiting (token bucket),&#10;ETag/Last-Modified conditional GET (skip unchanged),&#10;user-agent identified, allow-list domains only (Firestore registry)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="440" y="70" width="380" height="90" as="geometry"/></mxCell>

        <mxCell id="c3" value="Raw landing zone — GCS&#10;raw HTML / PDF / CSV, immutable, versioned,&#10;object metadata: sourceUrl, fetchTs, sha256" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="900" y="80" width="300" height="70" as="geometry"/></mxCell>

        <mxCell id="c4" value="Parse dispatcher — Eventarc on GCS object.finalize&#10;routes by content type + per-source parse contract" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="470" y="210" width="320" height="60" as="geometry"/></mxCell>

        <mxCell id="p1" value="HTML parser — Cloud Run&#10;stage 1: boilerplate removal (trafilatura)&#10;stage 2: DOM structure extraction (lxml/BeautifulSoup,&#10;per-source CSS/XPath selectors from parse contract)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="100" y="320" width="320" height="90" as="geometry"/></mxCell>

        <mxCell id="p2" value="PDF/scan parser — Document AI&#10;gazettes, official notifications;&#10;OCR + layout/table extraction → structured text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="470" y="320" width="320" height="90" as="geometry"/></mxCell>

        <mxCell id="p3" value="Tabular parser — Cloud Run&#10;CSV/XLS electoral + registry files,&#10;schema-mapped per parse contract" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="840" y="320" width="300" height="90" as="geometry"/></mxCell>

        <mxCell id="rx" value="RE2 REGEX ENGINE — extraction layer (Cloud Run lib)&#10;linear-time RE2 (no catastrophic backtracking on hostile input); versioned pattern library in Firestore:&#10;• person names incl. honorifics (Shri/Smt/Hon./Dr.) and initials&#10;• role/designation patterns (Minister of X, MP — constituency, Secretary, Chairman of Y)&#10;• date patterns (term start/end, appointed/elected/resigned on DD-MM-YYYY, multiple locale formats)&#10;• constituency / jurisdiction / department captures&#10;• ID-like tokens (gazette no., notification ref) for provenance&#10;each pattern: named capture groups + unit tests + pattern version id recorded per extraction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="220" y="470" width="800" height="150" as="geometry"/></mxCell>

        <mxCell id="p5" value="NER fallback — light model (Cloud Run)&#10;spaCy/transformer NER where regex confidence low;&#10;regex + NER agreement raises extraction confidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="100" y="670" width="320" height="80" as="geometry"/></mxCell>

        <mxCell id="p6" value="Normaliser + validator — Cloud Run&#10;transliteration, date canonicalisation (UTC ISO), role taxonomy&#10;mapping (raw title → PEP category code), schema validation,&#10;dedupe vs existing index (name+role+jurisdiction key)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="470" y="670" width="340" height="90" as="geometry"/></mxCell>

        <mxCell id="d1" value="Extraction confidence&#10;≥ threshold AND&#10;schema valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="560" y="800" width="160" height="90" as="geometry"/></mxCell>

        <mxCell id="q1" value="Quarantine queue — Pub/Sub + BigQuery table&#10;failed/low-confidence parses; data-steward review UI&#10;(Cloud Run); fixes feed pattern-library updates&#10;(regex improvement loop)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="880" y="800" width="320" height="90" as="geometry"/></mxCell>

        <mxCell id="idx" value="Role index publish&#10;BigQuery (analytics) + AlloyDB (serving) upsert;&#10;provenance: sourceUrl, fetchTs, patternVer, parserVer;&#10;index-change event → invalidate related Memorystore keys&#10;+ mark bloom filter rebuild" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="470" y="950" width="340" height="110" as="geometry"/></mxCell>

        <mxCell id="g1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1050" y="240"/></Array></mxGeometry></mxCell>
        <mxCell id="g4" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="c4" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g5" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="c4" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g6" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="c4" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g7" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="p1" target="rx"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g8" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="p2" target="rx"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g9" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="p3" target="rx"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g10" value="low-confidence spans" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="rx" target="p5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g11" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="rx" target="p6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g12" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="p5" target="p6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g13" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="p6" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g14" value="fail" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="d1" target="q1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g15" value="pass" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="d1" target="idx"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g16" value="pattern fixes (loop)" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="q1" target="rx"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1230" y="845"/><mxPoint x="1230" y="545"/></Array></mxGeometry></mxCell>
        <mxCell id="g17" value="re-parse after fix (loop)" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="q1" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1320" y="845"/><mxPoint x="1320" y="240"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="p3" name="3 - Step 5 deep dive + auto-training from reviewer decisions">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1450" pageHeight="1750">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <mxCell id="z0" value="Step 5 deep dive — SLM/LLM scoring internals + AUTO-TRAINING loops fed by L0/L1 decisions and comments" style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="30" as="geometry"/></mxCell>

        <mxCell id="i1" value="Input: rule survivors + feature vector&#10;(DLP-tokenised at this boundary)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="70" width="280" height="60" as="geometry"/></mxCell>

        <mxCell id="i2" value="Prompt builder — versioned templates (GCS registry,&#10;promptVer audited) + few-shot exemplars drawn from&#10;confirmed past cases (BQ) + strict JSON schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="120" y="170" width="300" height="80" as="geometry"/></mxCell>

        <mxCell id="i3" value="SLM inference — Qwen3-8B + ACTIVE LoRA ADAPTER&#10;(adapterVer from Model Registry) on GKE vLLM,&#10;prefix caching, min replicas ≥ 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="120" y="290" width="300" height="80" as="geometry"/></mxCell>

        <mxCell id="i4" value="Self-consistency loop&#10;k=3 (temp 0.4), majority vote,&#10;disagreement → confidence penalty" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="500" y="290" width="250" height="80" as="geometry"/></mxCell>

        <mxCell id="i5" value="JSON validate + repair loop&#10;max 2 re-prompts → still invalid → escalate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="500" y="400" width="250" height="60" as="geometry"/></mxCell>

        <mxCell id="i6" value="Calibration — isotonic scaler&#10;(calibVer; refreshed by threshold loop below)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="120" y="400" width="300" height="60" as="geometry"/></mxCell>

        <mxCell id="i7" value="Threshold router&#10;(bands from Firestore, bandVer)&#10;low → candidate-NO | high → candidate-YES&#10;gray / low-confidence → step 6" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="200" y="500" width="300" height="120" as="geometry"/></mxCell>

        <mxCell id="i8" value="STEP 6 — Gemini ReAct research loop&#10;PLAN → TOOL → ACT → OBSERVE → REFLECT (max 6 iters, token budget);&#10;allow-listed tools: yente deep match, Wikidata SPARQL, Mosaic association&#10;lookup, role index, evidence retrieval; critic pass (1 revision max);&#10;full tool trace → BQ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="560" y="490" width="430" height="130" as="geometry"/></mxCell>

        <mxCell id="i9" value="Result assembly → portal&#10;score, binary recommendation, rationale, evidence, versions&#10;(adapterVer, promptVer, calibVer, bandVer, rulesetVer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="200" y="680" width="440" height="80" as="geometry"/></mxCell>

        <mxCell id="i10" value="L0/L1 DECISION (portal, same sitting)&#10;CONFIRM | OVERRIDE + mandatory reason comment | SEND-BACK + note&#10;→ register write only after sign-off; every action + comment emitted as&#10;feedback event → Pub/Sub topic: screening.feedback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1"><mxGeometry x="200" y="800" width="440" height="100" as="geometry"/></mxCell>

        <mxCell id="lane" value="AUTO-TRAINING SUBSYSTEM (offline; no self-promotion — human ML-owner gate)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="80" y="950" width="1300" height="720" as="geometry"/></mxCell>

        <mxCell id="f1" value="decision_feedback (BigQuery)&#10;caseId, features, model outputs, reviewer decision,&#10;override reason, send-back note, all component versions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="110" y="1000" width="330" height="80" as="geometry"/></mxCell>

        <mxCell id="f2" value="Label curation job (weekly, Cloud Run)&#10;dedupe; DLP-scrub PII from training text; drop ambiguous&#10;labels; class rebalance (oversample overrides); frozen&#10;holdout split; lineage tags" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="110" y="1120" width="330" height="100" as="geometry"/></mxCell>

        <mxCell id="f3" value="Training trigger policy&#10;fire when: ≥500 new curated labels OR override-rate &gt; X%&#10;(7d) OR drift alert (feature/score distribution shift);&#10;never on blind schedule" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="130" y="1260" width="290" height="130" as="geometry"/></mxCell>

        <mxCell id="f4" value="Vertex AI Pipelines — LoRA fine-tune run&#10;Qwen3-8B base frozen; adapter trained on GKE GPU pool&#10;(Spot OK); hyperparams + data snapshot + lineage logged;&#10;output: candidate adapter vN+1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="510" y="1000" width="360" height="100" as="geometry"/></mxCell>

        <mxCell id="f5" value="Eval harness (hard gates)&#10;golden set (curated tricky cases: transliteration, association,&#10;common names) + frozen holdout; gates: overall accuracy,&#10;FALSE-NEGATIVE ceiling (missed-PEP rate ≈ 0), no regression&#10;per country/name-script slice; report → BQ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="510" y="1140" width="360" height="120" as="geometry"/></mxCell>

        <mxCell id="f6" value="Vertex Model Registry&#10;versioned adapters, eval reports attached,&#10;current-prod pointer, one-click rollback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="510" y="1300" width="360" height="70" as="geometry"/></mxCell>

        <mxCell id="f7" value="Shadow deployment (~2 weeks)&#10;candidate adapter scores live cases in parallel;&#10;outputs logged, never shown/used; agreement vs&#10;reviewer decisions compared to prod adapter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="950" y="1000" width="330" height="100" as="geometry"/></mxCell>

        <mxCell id="f8" value="Promotion gate — HUMAN&#10;ML owner + compliance sign-off on eval + shadow&#10;report; then canary 10% → 100%; auto-rollback on&#10;override-rate spike; adapterVer stamped in audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1"><mxGeometry x="950" y="1140" width="330" height="100" as="geometry"/></mxCell>

        <mxCell id="f9" value="PROMPT LOOP (cheaper, first resort)&#10;send-back notes clustered monthly → template + exemplar-pool&#10;updates in prompt registry (promptVer); fixes retrieval/rationale&#10;defects that are NOT weight problems" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="950" y="1300" width="330" height="100" as="geometry"/></mxCell>

        <mxCell id="f10" value="THRESHOLD / CALIBRATION LOOP (monthly)&#10;reviewer outcomes → refit isotonic scaler (calibVer) +&#10;re-tune router bands (bandVer); no model change needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="110" y="1440" width="330" height="90" as="geometry"/></mxCell>

        <mxCell id="f11" value="Drift monitor (continuous)&#10;feature + score distributions, override-rate by segment&#10;→ alerts feed the training trigger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="510" y="1440" width="360" height="90" as="geometry"/></mxCell>

        <mxCell id="y1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="i1" target="i2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="y2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="i2" target="i3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="y3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="i3" target="i4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="y4" value="k samples" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="i4" target="i3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="270"/></Array></mxGeometry></mxCell>
        <mxCell id="y5" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="i4" target="i5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="y6" value="repair" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="i5" target="i3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="430"/><mxPoint x="470" y="330"/></Array></mxGeometry></mxCell>
        <mxCell id="y7" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="i5" target="i6"><mxGeometry relative="1" as="geometry"/></mxCell>
