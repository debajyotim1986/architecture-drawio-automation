<mxfile host="app.diagrams.net" type="device"><diagram id="h" name="High-level process flow"><mxGraphModel dx="2668" dy="1380" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2668" pageHeight="1380" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="h1" value="&lt;b&gt;Looker write-back – high-level process flow&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontSize=28;fontColor=#1F1F1F;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="2608" height="40" as="geometry"/></mxCell><mxCell id="h2" value="Swimlanes show who acts. Diamonds are checks; any “No” stops the write (red lane) and is audited. Happy path ends with the new value on the dashboard." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontSize=15;fontColor=#444444;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="62" width="2608" height="46" as="geometry"/></mxCell><mxCell id="h3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#A0430A;strokeWidth=2;fontSize=14;fontColor=#1F1F1F;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="2608" height="170" as="geometry"/></mxCell><mxCell id="h4" value="&lt;b&gt;User&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A0430A;strokeColor=#A0430A;strokeWidth=2;fontSize=16;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="190" height="170" as="geometry"/></mxCell><mxCell id="h5" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#38761D;strokeWidth=2;fontSize=14;fontColor=#1F1F1F;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="290" width="2608" height="