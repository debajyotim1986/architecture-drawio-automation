&lt;b style=&quot;color:#0078D4&quot;&gt;0.1&lt;/b&gt;&amp;nbsp; user signs in to Looker (SAML)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0078D4;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="92" y="340" width="256" height="40" as="geometry"/></mxCell><mxCell id="v12" value="&lt;b style=&quot;color:#0078D4&quot;&gt;0.2&lt;/b&gt;&amp;nbsp; MFA · Conditional Access" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0078D4;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="92" y="388" width="256" height="40" as="geometry"/></mxCell><mxCell id="v13" value="&lt;b style=&quot;color:#0078D4&quot;&gt;0.3&lt;/b&gt;&amp;nbsp; assertion: oid · upn · groups" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0078D4;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="92" y="436" width="256" height="40" as="geometry"/></mxCell><mxCell id="v14" value="Looker dashboard" style="image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="530" y="180" width="56" height="56" as="geometry"/></mxCell><mxCell id="v15" value="Action Hub (custom action server)" style="image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="792" y="180" width="56" height="56" as="geometry"/></mxCell><mxCell id="v16" value="&lt;b&gt;Click&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00897B;strokeWidth=2;fontSize=13;align=center;verticalAlign=top;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="