<mxfile host="app.diagrams.net"><diagram id="d1" name="Looker Write-Back (Action Hub → ID&amp;A JWT → JWKS verify → M2M)"><mxGraphModel dx="2340" dy="1640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2340" pageHeight="1640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;Looker Write-Back → BigQuery — Action Hub exchanges an Entra token for an ID&amp;amp;A JWT (via Apigee); Write-back API verifies it with JWKS; then machine-to-machine on service accounts&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=18;align=center;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="2220" height="40" as="geometry"/></mxCell><mxCell id="v2" value="Each hop is broken into numbered steps. Numbered circles sit beside the connectors. Solid = request, dashed = response / key lookup." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=10;fontColor=#455A64;" vertex="1" parent="1"><mxGeometry x="60" y="62" width="2220" height="30" as="geometry"/></mxCell><mxCell id="v3" value="0 · IDENTITY — Microsoft Entra ID" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0078D4;strokeWidth=1.5;fontSize=14;align=left;verticalAlign=top;spacing=10;fontColor=#1F2A33;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="320" height="640" as="geometry"/></mxCell><mxCell id="v4" value="1 · LOOKER (SAML-SSO) + ACTION HUB" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=1.5;fontSize=14;align=left;verticalAlign=top;spacing=10;fontColor=#1F2A33;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="120" width="520" height="640" as="geometry"/></mxCell><mxCell id="v5" v