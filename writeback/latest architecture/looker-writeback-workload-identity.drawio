<mxfile host="app.diagrams.net"><diagram id="d1" name="Looker Write-Back – Workload Identity (machine-to-machine)"><mxGraphModel dx="2340" dy="1720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2340" pageHeight="1720" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v1" value="&lt;b&gt;Looker Write-Back → BigQuery — services prove who they are to each other with Google-signed tokens (Workload Identity) · no passwords, keys or client secrets · user permission from Looker&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=18;align=center;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="2220" height="40" as="geometry" /></mxCell><mxCell id="v2" value="All application components in Spoke 2: Looker + Action Hub on the Looker GKE cluster; Write-back API + Writer on a separate write-back GKE cluster (same VPC). Microsoft Entra is used only for user sign-in to Looker. Solid = request, dashed = response / key lookup." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=10;fontColor=#455A64;" vertex="1" parent="1"><mxGeometry x="60" y="62" width="2220" height="30" as="geometry" /></mxCell><mxCell id="v3" value="SPOKE 2 VPC" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#5F6B7A;strokeWidth=1.5;fontSize=14;align=left;verticalAlign=bottom;spacing=10;fontColor=#1F2A33;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="425" y="98" width="1430" height="687" as="geometry" /></mxCell><mxCell id="v4" value="WRITE-BACK GKE CLUSTER (new) · Spoke 2 · ns writeback" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EEF4FB;strokeColor=#12355B;strokeWidth=1.5;fontSize=13;align=right;verticalAlign=bottom;spacing=10;fontColor=#1F2A33;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1008" y="106" width="840" height="672" as="geometry" /></mxCell><mxCell id="v5" value="0 · USER SIGN-IN — Microsoft Entra ID" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0078D4;strokeWidth=1.5;fontSize=14;align=left;verticalAlign=top;spacing=10;fontColor=#1F2A33;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="320" height="640" as="geometry" /></mxCell><mxCell id="v6" value="1 · LOOKER GKE CLUSTER (Spoke 2) — Looker + Action Hub" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=1.5;fontSize=14;align=left;verticalAlign=top;spacing=10;fontColor=#1F2A33;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="120" width="520" height="640" as="geometry" /></mxCell><mxCell id="v7" value="2 · WRITE-BACK API — checks the caller, then the user" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;strokeWidth=1.5;fontSize=14;align=left;verticalAlign=top;spacing=10;fontColor=#1F2A33;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1020" y="120" width="400" height="620" as="geometry" /></mxCell><mxCell id="v8" value="3 · WRITER API — checks the caller, then saves" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;strokeWidth=1.5;fontSize=14;align=left;verticalAlign=top;spacing=10;fontColor=#1F2A33;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1480" y="120" width="360" height="620" as="geometry" /></mxCell><mxCell id="v9" value="4 · BIGQUERY — stores the change" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F4B400;strokeWidth=1.5;fontSize=14;align=left;verticalAlign=top;spacing=10;fontColor=#1F2A33;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1900" y="120" width="380" height="640" as="geometry" /></mxCell><mxCell id="v10" value="Internal user" style="shape=mxgraph.gcp2.hexIcon;prIcon=users;fillColor=#4284F3;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="90" y="180" width="56" height="56" as="geometry" /></mxCell><mxCell id="v11" value="Entra ID (SAML IdP)" style="shape=mxgraph.azure.azure_active_directory;fillColor=#0078D4;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="250" y="180" width="56" height="56" as="geometry" /></mxCell><mxCell id="v12" value="&lt;b&gt;Sign-in&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;fontSize=13;align=center;verticalAlign=top;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="80" y="300" width="280" height="190" as="geometry" /></mxCell><mxCell id="v13" value="&lt;b style=&quot;color:#0078D4&quot;&gt;0.1&lt;/b&gt;&amp;nbsp; user signs in to Looker with the company login" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0078D4;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="92" y="340" width="256" height="40" as="geometry" /></mxCell><mxCell id="v14" value="&lt;b style=&quot;color:#0078D4&quot;&gt;0.2&lt;/b&gt;&amp;nbsp; Entra checks MFA and access rules" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0078D4;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="92" y="388" width="256" height="40" as="geometry" /></mxCell><mxCell id="v15" value="&lt;b style=&quot;color:#0078D4&quot;&gt;0.3&lt;/b&gt;&amp;nbsp; Looker receives who the user is (name, groups)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0078D4;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="92" y="436" width="256" height="40" as="geometry" /></mxCell><mxCell id="v16" value="Looker dashboard" style="image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="530" y="180" width="56" height="56" as="geometry" /></mxCell><mxCell id="v17" value="Action Hub (custom action server)" style="image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="792" y="180" width="56" height="56" as="geometry" /></mxCell><mxCell id="v18" value="&lt;b&gt;Click&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00897B;strokeWidth=2;fontSize=13;align=center;verticalAlign=top;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="460" y="300" width="220" height="190" as="geometry" /></mxCell><mxCell id="v19" value="&lt;b style=&quot;color:#00897B&quot;&gt;1.1&lt;/b&gt;&amp;nbsp; user clicks “Write back” on a value" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="472" y="340" width="196" height="40" as="geometry" /></mxCell><mxCell id="v20" value="&lt;b style=&quot;color:#00897B&quot;&gt;1.2&lt;/b&gt;&amp;nbsp; Looker server sends the request to the Action Hub" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="472" y="388" width="196" height="40" as="geometry" /></mxCell><mxCell id="v21" value="&lt;b style=&quot;color:#00897B&quot;&gt;1.3&lt;/b&gt;&amp;nbsp; adds shared secret + user email, id, permission" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="472" y="436" width="196" height="40" as="geometry" /></mxCell><mxCell id="v22" value="&lt;b&gt;Who may write (Looker)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00897B;strokeWidth=2;fontSize=13;align=center;verticalAlign=top;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="460" y="520" width="220" height="154" as="geometry" /></mxCell><mxCell id="v23" value="&lt;b style=&quot;color:#00897B&quot;&gt;0.4&lt;/b&gt;&amp;nbsp; admin adds the user to group “Writeback Users”" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="472" y="560" width="196" height="46" as="geometry" /></mxCell><mxCell id="v24" value="&lt;b style=&quot;color:#00897B&quot;&gt;0.5&lt;/b&gt;&amp;nbsp; group members get writeback_allowed = yes" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="472" y="614" width="196" height="46" as="geometry" /></mxCell><mxCell id="v25" value="&lt;b&gt;Action Hub&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00897B;strokeWidth=2;fontSize=13;align=center;verticalAlign=top;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="700" y="300" width="240" height="286" as="geometry" /></mxCell><mxCell id="v26" value="&lt;b style=&quot;color:#00897B&quot;&gt;2.1&lt;/b&gt;&amp;nbsp; check shared secret: request is from our Looker" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="712" y="340" width="216" height="40" as="geometry" /></mxCell><mxCell id="v27" value="&lt;b style=&quot;color:#00897B&quot;&gt;2.2&lt;/b&gt;&amp;nbsp; &lt;b&gt;get a token from Google (no password)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=3;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="712" y="388" width="216" height="40" as="geometry" /></mxCell><mxCell id="v28" value="&lt;b style=&quot;color:#00897B&quot;&gt;2.3&lt;/b&gt;&amp;nbsp; &lt;b&gt;token says: from Action Hub · for Write-back API&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=3;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="712" y="436" width="216" height="40" as="geometry" /></mxCell><mxCell id="v29" value="&lt;b style=&quot;color:#00897B&quot;&gt;2.4&lt;/b&gt;&amp;nbsp; keep the token ~55 min, then get a new one" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="712" y="484" width="216" height="40" as="geometry" /></mxCell><mxCell id="v30" value="&lt;b style=&quot;color:#00897B&quot;&gt;3.1&lt;/b&gt;&amp;nbsp; send the request + token to the Write-back API" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="712" y="532" width="216" height="40" as="geometry" /></mxCell><mxCell id="v31" value="Write-back API" style="shape=mxgraph.gcp2.hexIcon;prIcon=container_engine;fillColor=#4284F3;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1192" y="180" width="56" height="56" as="geometry" /></mxCell><mxCell id="v32" value="&lt;b&gt;Check the caller, then the user&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#34A853;strokeWidth=2;fontSize=13;align=center;verticalAlign=top;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1040" y="300" width="360" height="334" as="geometry" /></mxCell><mxCell id="v33" value="&lt;b style=&quot;color:#34A853&quot;&gt;3.2&lt;/b&gt;&amp;nbsp; get Google’s public keys to check tokens (kept in memory)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1052" y="340" width="336" height="40" as="geometry" /></mxCell><mxCell id="v34" value="&lt;b style=&quot;color:#34A853&quot;&gt;3.3&lt;/b&gt;&amp;nbsp; check token: from Action Hub? for me? not expired?" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1052" y="388" width="336" height="40" as="geometry" /></mxCell><mxCell id="v35" value="&lt;b style=&quot;color:#34A853&quot;&gt;3.4&lt;/b&gt;&amp;nbsp; any check fails → reject (401)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1052" y="436" width="336" height="40" as="geometry" /></mxCell><mxCell id="v36" value="&lt;b style=&quot;color:#34A853&quot;&gt;4&lt;/b&gt;&amp;nbsp; check the user: writeback_allowed must be yes, else reject (403)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1052" y="484" width="336" height="40" as="geometry" /></mxCell><mxCell id="v37" value="&lt;b style=&quot;color:#34A853&quot;&gt;5&lt;/b&gt;&amp;nbsp; check the value against business rules · give the request an id" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1052" y="532" width="336" height="40" as="geometry" /></mxCell><mxCell id="v38" value="&lt;b style=&quot;color:#34A853&quot;&gt;6&lt;/b&gt;&amp;nbsp; &lt;b&gt;get its own token and call the Writer&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;strokeWidth=3;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1052" y="580" width="336" height="40" as="geometry" /></mxCell><mxCell id="v39" value="Writer API" style="shape=mxgraph.gcp2.hexIcon;prIcon=container_engine;fillColor=#4284F3;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1632" y="180" width="56" height="56" as="geometry" /></mxCell><mxCell id="v40" value="&lt;b&gt;Check the caller, then save&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0288D1;strokeWidth=2;fontSize=13;align=center;verticalAlign=top;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1500" y="300" width="320" height="238" as="geometry" /></mxCell><mxCell id="v41" value="&lt;b style=&quot;color:#0288D1&quot;&gt;6.1&lt;/b&gt;&amp;nbsp; check token: from Write-back API? for me? not expired?" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;strokeWidth=1;fontSize=12;align=left