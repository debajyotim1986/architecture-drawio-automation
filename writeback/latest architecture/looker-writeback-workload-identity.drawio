b&gt;Google checks the rule: Action Hub may act as action-hub@&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=3;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="842" y="1026" width="406" height="48" as="geometry" /></mxCell><mxCell id="g2r3" value="&lt;b style=&quot;color:#E65100&quot;&gt;2.2d&lt;/b&gt;&amp;nbsp; &lt;b&gt;Google returns a signed token · valid 1 hour&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=3;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="842" y="1084" width="406" height="48" as="geometry" /></mxCell><mxCell id="g3" value="&lt;b&gt;Google public keys (used to check tokens)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#34A853;strokeWidth=2;fontSize=13;align=center;verticalAlign=top;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1290" y="870" width="380" height="300" as="geometry" /></mxCell><mxCell id="g3r0" value="&lt;b style=&quot;color:#34A853&quot;&gt;3.2a&lt;/b&gt;&amp;nbsp; published openly by Google – nothing secret" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#34A853;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1302" y="910" width="356" height="48" as="geometry" /></mxCell><mxCell id="g3r1" value="&lt;b style=&quot;color:#34A853&quot;&gt;3.2b&lt;/b&gt;&amp;nbsp; Write-back API keeps a copy in memory" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#34A853;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1302" y="968" width="356" height="48" as="geometry" /></mxCell><mxCell id="g3r2" value="&lt;b style=&quot;color:#34A853&quot;&gt;3.3&lt;/b&gt;&amp;nbsp; check: from Action Hub? for me? not expired?" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#34A853;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1302" y="1026" width="356" height="48" as="geometry" /></mxCell><mxCell id="g3r3" value="&lt;b style=&quot;color:#34A853&quot;&gt;3.4&lt;/b&gt;&amp;nbsp; wrong sender or receiver → reject (401 / 403)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#34A853;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1302" y="1084" width="356" height="48" as="geometry" /></mxCell><mxCell id="g5" value="&lt;b&gt;Who may act as whom (access rules)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1565C0;strokeWidth=3.5;fontSize=13;align=center;verticalAlign=top;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1700" y="870" width="560" height="300" as="geometry" /></mxCell><mxCell id="g5r0" value="&lt;b&gt;Action Hub&lt;/b&gt; (Looker cluster) → may act as &lt;b&gt;action-hub@&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=3;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1712" y="910" width="536" height="48" as="geometry" /></mxCell><mxCell id="g5r1" value="&lt;b&gt;Write-back API&lt;/b&gt; (write-back cluster) → may act as &lt;b&gt;writeback-api@&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=3;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1712" y="968" width="536" height="48" as="geometry" /></mxCell><mxCell id="g5r2" value="&lt;b&gt;Writer&lt;/b&gt; (write-back cluster) → may act as &lt;b&gt;writer@&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=3;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1712" y="1026" width="536" height="48" as="geometry" /></mxCell><mxCell id="g5r3" value="remove a rule → that application can no longer get tokens" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1712" y="1084" width="536" height="48" as="geometry" /></mxCell><mxCell id="s0" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#1F4E79;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="2280.0" width="2220" height="980" as="geometry" /></mxCell><mxCell id="s0t" value="&lt;b&gt;How Workload Identity works for machine-to-machine calls – step by step&lt;/b&gt;" style="text;html=1;fontSize=20;fontColor=#1F4E79;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="2294.0" width="2180" height="34" as="geometry" /></mxCell><mxCell id="s0s" value="Think of a Google &lt;b&gt;service account&lt;/b&gt; as an employee badge for software. Workload Identity lets each application wear its own badge without ever holding a password or key; Google checks the badge on every call. &lt;b&gt;Steps with a thick border and bold text are Workload Identity steps.&lt;/b&gt;" style="text;html=1;fontSize=13;fontColor=#3A4A5C;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="2328.0" width="2180" height="28" as="geometry" /></mxCell><mxCell id="sh1" value="&lt;b&gt;ONE-TIME SET-UP&lt;/b&gt; (done by the platform team, in the runbook)" style="text;html=1;fontSize=13;fontColor=#6A1B9A;align=left;" vertex="1" parent="1"><mxGeometry x="80" y="2372.0" width="700" height="26" as="geometry" /></mxCell><mxCell id="sa0b" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=3.5;" vertex="1" parent="1"><mxGeometry x="80" y="2402.0" width="710" height="84" as="geometry" /></mxCell><mxCell id="sa0n" value="&lt;b&gt;A&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6A1B9A;strokeColor=none;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="92" y="2422.0" width="44" height="44" as="geometry" /></mxCell><mxCell id="sa0t" value="&lt;b style=&quot;color:#6A1B9A&quot;&gt;Give each service its own identity · Workload Identity&lt;/b&gt;&lt;br&gt;Action Hub, Write-back API and Writer each get their own Google service account: &lt;b&gt;action-hub@&lt;/b&gt;, &lt;b&gt;writeback-api@&lt;/b&gt;, &lt;b&gt;writer@&lt;/b&gt;." style="text;html=1;whiteSpace=wrap;fontSize=12.5;fontColor=#1F2A33;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="148" y="2408.0" width="630" height="72" as="geometry" /></mxCell><mxCell id="sa1b" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=3.5;" vertex="1" parent="1"><mxGeometry x="810" y="2402.0" width="710" height="84" as="geometry" /></mxCell><mxCell id="sa1n" value="&lt;b&gt;B&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6A1B9A;strokeColor=none;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="822" y="2422.0" width="44" height="44" as="geometry" /></mxCell><mxCell id="sa1t" value="&lt;b style=&quot;color:#6A1B9A&quot;&gt;Link each application to its identity · Workload Identity&lt;/b&gt;&lt;br&gt;An access rule says, for example, “only the Action Hub may act as action-hub@”. No other application can use that identity." style="text;html=1;whiteSpace=wrap;fontSize=12.5;fontColor=#1F2A33;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="878" y="2408.0" width="630" height="72" as="geometry" /></mxCell><mxCell id="sa2b" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1540" y="2402.0" width="710" height="84" as="geometry" /></mxCell><mxCell id="sa2n" value="&lt;b&gt;C&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6A1B9A;strokeColor=none;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1552" y="2422.0" width="44" height="44" as="geometry" /></mxCell><mxCell id="sa2t" value="&lt;b style=&quot;color:#6A1B9A&quot;&gt;Give each identity only what it needs&lt;/b&gt;&lt;br&gt;&lt;b&gt;writer@&lt;/b&gt; may only add rows to one BigQuery table. The other two identities have no data access at all." style="text;html=1;whiteSpace=wrap;fontSize=12.5;fontColor=#1F2A33;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1608" y="2408.0" width="630" height="72" as="geometry" /></mxCell><mxCell id="sh2" value="&lt;b&gt;EVERY WRITE-BACK CLICK&lt;/b&gt; (automatic, takes milliseconds)" style="text;html=1;fontSize=13;fontColor=#1F4E79;align=left;" vertex="1" parent="1"><mxGeometry x="80" y="2510.0" width="900" height="26" as="geometry" /></mxCell><mxCell id="sc0b" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="2540.0" width="1080" height="84" as="geometry" /></mxCell><mxCell id="sc0n" value="&lt;b&gt;1&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#00897B;strokeColor=none;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="92" y="2560.0" width="44" height="44" as="geometry" /></mxCell><mxCell id="sc0t" value="&lt;b style=&quot;color:#00897B&quot;&gt;User clicks “Write back” in Looker&lt;/b&gt;&lt;br&gt;The Looker server (not the browser) sends the request to the Action Hub with a shared secret and the user’s details: email, user id and writeback_allowed." style="text;html=1;whiteSpace=wrap;fontSize=12.5;fontColor=#1F2A33;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="148" y="2546.0" width="1000" height="72" as="geometry" /></mxCell><mxCell id="sc1b" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=3.5;" vertex="1" parent="1"><mxGeometry x="1180" y="2540.0" width="1080" height="84" as="geometry" /></mxCell><mxCell id="sc1n" value="&lt;b&gt;2&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E65100;strokeColor=none;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1192" y="2560.0" width="44" height="44" as="geometry" /></mxCell><mxCell id="sc1t" value="&lt;b style=&quot;color:#E65100&quot;&gt;Action Hub asks Google for a token · Workload Identity&lt;/b&gt;&lt;br&gt;No password is used. The token says: &lt;b&gt;from Action Hub · for Write-back API&lt;/b&gt;." style="text;html=1;whiteSpace=wrap;fontSize=12.5;fontColor=#1F2A33;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1248" y="2546.0" width="1000" height="72" as="geometry" /></mxCell><mxCell id="sc2b" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=3.5;" vertex="1" parent="1"><mxGeometry x="80" y="2636.0" width="1080" height="84" as="geometry" /></mxCell><mxCell id="sc2n" value="&lt;b&gt;3&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E65100;strokeColor=none;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="92" y="2656.0" width="44" height="44" as="geometry" /></mxCell><mxCell id="sc2t" value="&lt;b style=&quot;color:#E65100&quot;&gt;Google checks the rule and signs the token · Workload Identity&lt;/b&gt;&lt;br&gt;Google confirms the access rule from step B, signs the token and makes it valid for 1 hour. The Action Hub reuses it for about 55 minutes." style="text;html=1;whiteSpace=wrap;fontSize=12.5;fontColor=#1F2A33;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="148" y="2642.0" width="1000" height="72" as="geometry" /></mxCell><mxCell id="sc3b" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1180" y="2636.0" width="1080" height="84" as="geometry" /></mxCell><mxCell id="sc3n" value="&lt;b&gt;4&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=none;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1192" y="2656.0" width="44" height="44" as="geometry" /></mxCell><mxCell id="sc3t" value="&lt;b style=&quot;color:#1565C0&quot;&gt;Action Hub calls the Write-back API&lt;/b&gt;&lt;br&gt;The request travels inside the Spoke 2 network through a private load balancer, with the token attached." style="text;html=1;whiteSpace=wrap;fontSize=12.5;fontColor=#1F2A33;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1248" y="2642.0" width="1000" height="72" as="geometry" /></mxCell><mxCell id="sc4b" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="2732.0" width="1080" height="84" as="geometry" /></mxCell><mxCell id="sc4n" value="&lt;b&gt;5&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=none;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="92" y="2752.0" width="44" height="44" as="geometry" /></mxCell><mxCell id="sc4t" value="&lt;b style=&quot;color:#2E7D32&quot;&gt;Write-back API checks the token&lt;/b&gt;&lt;br&gt;From Action Hub? For me? Not expired? If any answer is no, the request is rejected (401)." style="text;html=1;whiteSpace=wrap;fontSize=12.5;fontColor=#1F2A33;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="148" y="2738.0" width="1000" height="72" as="geometry" /></mxCell><mxCell id="sc5b" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1180" y="2732.0" width="1080" height="84" as="geometry" /></mxCell><mxCell id="sc5n" value="&lt;b&gt;6&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=none;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1192" y="2752.0" width="44" height="44" as="geometry" /></mxCell><mxCell id="sc5t" value="&lt;b style=&quot;color:#2E7D32&quot;&gt;Write-back API checks the user and the value&lt;/b&gt;&lt;br&gt;The user must be allowed to write (writeback_allowed = yes, else 403) and the value must pass the business rules." style="text;html=1;whiteSpace=wrap;fontSize=12.5;fontColor=#1F2A33;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1248" y="2738.0" width="1000" height="72" as="geometry" /></mxCell><mxCell id="sc6b" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=3.5;" vertex="1" parent="1"><mxGeometry x="80" y="2828.0" width="1080" height="84" as="geometry" /></mxCell><mxCell id="sc6n" value="&lt;b&gt;7&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E65100;strokeColor=none;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="92" y="2848.0" width="44" height="44" as="geometry" /></mxCell><mxCell id="sc6t" value="&lt;b style=&quot;color:#E65100&quot;&gt;Write-back API gets its own token · Workload Identity&lt;/b&gt;&lt;br&gt;In the same way as steps 2–3. The token says: &lt;b&gt;from Write-back API · for Writer&lt;/b&gt;. It then calls the Writer." style="text;html=1;whiteSpace=wrap;fontSize=12.5;fontColor=#1F2A33;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="148" y="2834.0" width="1000" height="72" as="geometry" /></mxCell><mxCell id="sc7b" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1180" y="2828.0" width="1080" height="84" as="geometry" /></mxCell><mxCell id="sc7n" value="&lt;b&gt;8&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=none;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1192" y="2848.0" width="44" height="44" as="geometry" /></mxCell><mxCell id="sc7t" value="&lt;b style=&quot;color:#2E7D32&quot;&gt;Writer checks the token&lt;/b&gt;&lt;br&gt;From Write-back API? For me? Not expired? Any other application, even inside the same cluster, is rejected (403)." style="text;html=1;whiteSpace=wrap;fontSize=12.5;fontColor=#1F2A33;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1248" y="2834.0" width="1000" height="72" as="geometry" /></mxCell><mxCell id="sc8b" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDEEE2;strokeColor=#B4530B;strokeWidth=3.5;" vertex="1" parent="1"><mxGeometry x="80" y="2924.0" width="1080" height="84" as="geometry" /></mxCell><mxCell id="sc8n" value="&lt;b&gt;9&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#B4530B;strokeColor=none;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="92" y="2944.0" width="44" height="44" as="geometry" /></mxCell><mxCell id="sc8t" value="&lt;b style=&quot;color:#B4530B&quot;&gt;Writer saves the change in BigQuery · Workload Identity&lt;/b&gt;&lt;br&gt;Its Google library automatically gets an access token as writer@ and adds one row (who, what, when). A repeated click is ignored." style="text;html=1;whiteSpace=wrap;fontSize=12.5;fontColor=#1F2A33;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="148" y="2930.0" width="1000" height="72" as="geometry" /></mxCell><mxCell id="sc9b" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1180" y="2924.0" width="1080" height="84" as="geometry" /></mxCell><mxCell id="sc9n" value="&lt;b&gt;10&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#00897B;strokeColor=none;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1192" y="2944.0" width="44" height="44" as="geometry" /></mxCell><mxCell id="sc9t" value="&lt;b style=&quot;color:#00897B&quot;&gt;Result back to the user&lt;/b&gt;&lt;br&gt;Success travels back to Looker, the dashboard refreshes and shows the new value. Every step is logged with the same request id." style="text;html=1;whiteSpace=wrap;fontSize=12.5;fontColor=#1F2A33;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1248" y="2930.0" width="1000" height="72" as="geometry" /></mxCell><mxCell id="sk" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="3028.0" width="2180" height="210" as="geometry" /></mxCell><mxCell id="skt" value="&lt;b style=&quot;font-size:15px&quot;&gt;What this means for the business&lt;/b&gt;&lt;br&gt;• &lt;b&gt;No passwords, keys or secrets&lt;/b&gt; are exchanged between the applications – nothing can be stolen from a file or a log.&lt;br&gt;• &lt;b&gt;Every call proves who is calling&lt;/b&gt;: the Write-back API only trusts the Action Hub, and the Writer only trusts the Write-back API.&lt;br&gt;• &lt;b&gt;Tokens expire within an hour&lt;/b&gt; and are addressed to one receiver, so a copied token is useless elsewhere and soon useless altogether.&lt;br&gt;• &lt;b&gt;Access is switched off in one place&lt;/b&gt;: removing an IAM rule stops that application immediately – no password changes needed.&lt;br&gt;• &lt;b&gt;The user’s permission still comes from Looker&lt;/b&gt; (group “Writeback Users”), and every saved change records who made it." style="text;html=1;whiteSpace=wrap;fontSize=13.5;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="100" y="3038.0" width="2140" height="190" as="geometry" /></mxCell><mxCell id="wl0" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="80" y="520" width="280" height="225" as="geometry" /></mxCell><mxCell id="wl1" value="&lt;b style=&quot;font-size:13px;color:#1F4E79&quot;&gt;WHERE WORKLOAD IDENTITY TAKES PLACE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px&quot;&gt;Thick border + bold text = an application gets its Google identity or a token, with no password or key.&lt;br&gt;&lt;br&gt;&lt;b&gt;2.2&lt;/b&gt; Action Hub gets its token&lt;br&gt;&lt;b&gt;2.2a–d&lt;/b&gt; Google token service on the node&lt;br&gt;&lt;b&gt;6&lt;/b&gt; Write-back API gets its token&lt;br&gt;&lt;b&gt;7&lt;/b&gt; Writer gets BigQuery access&lt;br&gt;&lt;b&gt;Rules&lt;/b&gt; who may act as whom&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontColor=#1F2A33;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="90" y="528" width="260" height="212" as="geometry" /></mxCell><mxCell id="t1" value="🔒 TLS ①" style="rounded=1;arcSize=50;html=1;fillColor=#00695C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="318" y="214" width="92" height="24" as="geometry" /></mxCell><mxCell id="t2" value="🔒 TLS ②" style="rounded=1;arcSize=50;html=1;fillColor=#00695C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="596" y="268" width="92" height="24" as="geometry" /></mxCell><mxCell id="t4" value="🔒 TLS ④" style="rounded=1;arcSize=50;html=1;fillColor=#00695C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1404" y="674" width="92" height="24" as="geometry" /></mxCell><mxCell id="k1" value="🔑 Looker secret (A)" style="rounded=1;arcSize=50;html=1;fillColor=#B07A14;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="484" width="160" height="24" as="geometry" /></mxCell><mxCell id="p0" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#1F4E79;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="1280" width="2220" height="520" as="geometry" /></mxCell><mxCell id="p0t" value="&lt;b&gt;TLS certificates on every connection · where the Looker credentials are entered and passed&lt;/b&gt;" style="text;html=1;fontSize=19;fontColor=#1F4E79;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="1292" width="2180" height="32" as="geometry" /></mxCell><mxCell id="p1" value="&lt;b style=&quot;color:#00695C&quot;&gt;🔒 TLS – every connection is encrypted (HTTPS)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00695C;strokeWidth=2;fontSize=14;align=center;verticalAlign=top;spacing=8;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="80" y="1332" width="1090" height="452" as="geometry" /></mxCell><mxCell id="p1r0" value="&lt;b style=&quot;color:#00695C&quot;&gt;①&lt;/b&gt;&amp;nbsp; &lt;b&gt;User browser → Looker&lt;/b&gt;&lt;br&gt;Looker’s existing HTTPS certificate · no change" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;strokeWidth=1;fontSize=12.5;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="92" y="1372" width="1066" height="60" as="geometry" /></mxCell><mxCell id="p1r1" value="&lt;b style=&quot;color:#00695C&quot;&gt;②&lt;/b&gt;&amp;nbsp; &lt;b&gt;Looker → Action Hub&lt;/b&gt;&lt;br&gt;certificate &lt;b&gt;action-hub-tls&lt;/b&gt; for action-hub.looker-actions.svc.cluster.local · Looker must trust the internal CA" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;strokeWidth=1;fontSize=12.5;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="92" y="1440" width="1066" height="60" as="geometry" /></mxCell><mxCell id="p1r2" value="&lt;b style=&quot;color:#00695C&quot;&gt;③&lt;/b&gt;&amp;nbsp; &lt;b&gt;Action Hub → Write-back API&lt;/b&gt;&lt;br&gt;certificate &lt;b&gt;writeback-api-tls&lt;/b&gt; for writeback-api-int.internal · Action Hub trusts the internal CA" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;strokeWidth=1;fontSize=12.5;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="92" y="1508" width="1066" height="60" as="geometry" /></mxCell><mxCell id="p1r3" value="&lt;b style=&quot;color:#00695C&quot;&gt;④&lt;/b&gt;&amp;nbsp; &lt;b&gt;Write-back API → Writer&lt;/b&gt;&lt;br&gt;certificate &lt;b&gt;writer-tls&lt;/b&gt; for writer.writeback.svc.cluster.local (+ writer.internal) · Write-back API trusts the internal CA" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;strokeWidth=1;fontSize=12.5;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="92" y="1576" width="1066" height="60" as="geometry" /></mxCell><mxCell id="p1r4" value="&lt;b style=&quot;color:#00695C&quot;&gt;⑤&lt;/b&gt;&amp;nbsp; &lt;b&gt;Services → Google (tokens, BigQuery, Secret Manager)&lt;/b&gt;&lt;br&gt;HTTPS managed by Google · nothing to set up" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;strokeWidth=1;fontSize=12.5;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="92" y="1644" width="1066" height="60" as="geometry" /></mxCell><mxCell id="p1r5" value="&lt;b&gt;How certificates are handled&lt;/b&gt;&lt;br&gt;PKI issues them → stored in &lt;b&gt;Secret Manager&lt;/b&gt; → mounted into each pod at start-up (never in images or config files) · renew before expiry" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=1;fontSize=12.5;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="92" y="1712" width="1066" height="60" as="geometry" /></mxCell><mxCell id="p2" value="&lt;b style=&quot;color:#B07A14&quot;&gt;🔑 Looker credentials – where to enter and pass them&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B07A14;strokeWidth=2;fontSize=14;align=center;verticalAlign=top;spacing=8;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1190" y="1332" width="1070" height="452" as="geometry" /></mxCell><mxCell id="p2r0" value="&lt;b style=&quot;color:#B07A14&quot;&gt;A&lt;/b&gt;&amp;nbsp; &lt;b&gt;Action Hub shared secret – the only Looker credential used per click&lt;/b&gt;&lt;br&gt;Generated once into Secret Manager as &lt;b&gt;looker-action-secret&lt;/b&gt;." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#B07A14;strokeWidth=1;fontSize=12.5;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1202" y="1372" width="1046" height="60" as="geometry" /></mxCell><mxCell id="p2r1" value="&lt;b style=&quot;color:#B07A14&quot;&gt;A1&lt;/b&gt;&amp;nbsp; &lt;b&gt;Enter it in Looker once&lt;/b&gt;&lt;br&gt;Admin › Platform › Actions › add Action Hub → &lt;b&gt;Authorization token&lt;/b&gt; field (done by the set-up script, so nobody copies it)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#B07A14;strokeWidth=1;fontSize=12.5;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1202" y="1440" width="1046" height="60" as="geometry" /></mxCell><mxCell id="p2r2" value="&lt;b style=&quot;color:#B07A14&quot;&gt;A2&lt;/b&gt;&amp;nbsp; &lt;b&gt;Looker passes it on every click (step 1.3)&lt;/b&gt;&lt;br&gt;In the request header to the Action Hub: &lt;b&gt;Authorization: Token token=&quot;…&quot;&lt;/b&gt; – over TLS ②." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#B07A14;strokeWidth=1;fontSize=12.5;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1202" y="1508" width="1046" height="60" as="geometry" /></mxCell><mxCell id="p2r3" value="&lt;b style=&quot;color:#B07A14&quot;&gt;A3&lt;/b&gt;&amp;nbsp; &lt;b&gt;Action Hub checks it (step 2.1)&lt;/b&gt;&lt;br&gt;Reads its own copy from Secret Manager and compares; wrong or missing → reject (401)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#B07A14;strokeWidth=1;fontSize=12.5;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1202" y="1576" width="1046" height="60" as="geometry" /></mxCell><mxCell id="p2r4" value="&lt;b style=&quot;color:#B07A14&quot;&gt;B&lt;/b&gt;&amp;nbsp; &lt;b&gt;Looker → BigQuery connection (reads the new values)&lt;/b&gt;&lt;br&gt;Admin › Connections: Looker’s own BigQuery service account, read-only on the &lt;b&gt;current_state&lt;/b&gt; view." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#90A4AE;strokeWidth=1;fontSize=12.5;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1202" y="1644" width="1046" height="60" as="geometry" /></mxCell><mxCell id="p2r5" value="&lt;b style=&quot;color:#B07A14&quot;&gt;C&lt;/b&gt;&amp;nbsp; &lt;b&gt;Looker API key (client id / secret)&lt;/b&gt;&lt;br&gt;Only for the admin set-up script · not used at run time · &lt;b&gt;not&lt;/b&gt; passed to the Write-back API or Writer." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#90A4AE;strokeWidth=1;fontSize=12.5;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1202" y="1712" width="1046" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>