" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#5F6B7A;strokeColor=#5F6B7A;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=10;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="80" y="2130.0" width="130" height="50" as="geometry" /></mxCell><mxCell id="v142" value="Action Hub (Looker cluster) → Write-back API private load balancer" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6B7A;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="230" y="2130.0" width="262" height="50" as="geometry" /></mxCell><mxCell id="v143" value="same Spoke 2 network · no HUB hop" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6B7A;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="542" y="2130.0" width="262" height="50" as="geometry" /></mxCell><mxCell id="e144" style="edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;jumpSize=12;rounded=1;html=1;strokeColor=#5F6B7A;strokeWidth=2;endArrow=block;endFill=1;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;startArrow=none;" edge="1" parent="1" source="v142" target="v143"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v145" value="firewall: only the Looker cluster may connect" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6B7A;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="854" y="2130.0" width="262" height="50" as="geometry" /></mxCell><mxCell id="e146" style="edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;jumpSize=12;rounded=1;html=1;strokeColor=#5F6B7A;strokeWidth=2;endArrow=block;endFill=1;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;startArrow=none;" edge="1" p