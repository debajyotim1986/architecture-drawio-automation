="shape=mxgraph.gcp2.hexIcon;prIcon=container_engine;fillColor=#4284F3;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1770" y="126" width="40" height="40" as="geometry"/></mxCell><mxCell id="v41" value="Secret Manager&lt;br&gt;3.1 looker-action-secret&lt;br&gt;(accessor: writeback-api@ only)" style="shape=mxgraph.gcp2.hexIcon;prIcon=cloud_security_scanner;fillColor=#4284F3;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1004" y="820" width="72" height="72" as="geometry"/></mxCell><mxCell id="v42" value="IAM&lt;br&gt;writeback-api@ · writer@&lt;br&gt;no key files" style="shape=mxgraph.gcp2.hexIcon;prIcon=cloud_iam;fillColor=#4284F3;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1314" y="820" width="72" height="72" as="geometry"/></mxCell><mxCell id="v43" value="Cloud Logging&lt;br&gt;8.3 audit: request_id,&lt;br&gt;user email / id, result" style="shape=mxgraph.gcp2.hexIcon;prIcon=cloud_logging;fillColor=#4284F3;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1624" y="820" width="72" height="72" as="geometry"/></mxCell><mxCell id="v44" value="&lt;b&gt;Secret Manager entry (sample — generate your own value)&lt;/b&gt;&lt;br&gt;Secret ID: &lt;b&gt;looker-action-secret&lt;/b&gt; &amp;nbsp;·&amp;nbsp; resource: projects/lbg-partner-tooling/secrets/looker-action-secret/versions/1&lt;br&gt;Value: 9f2c4a7e1b0d63a8c5e2f71d4b9a0c38e6f1a2b7d4c9e0f3a6b1c8d5e2f7a490&lt;br&gt;Same value in Looker › Admin › Actions › Authorization token &amp;nbsp;→&amp;nbsp; Looker sends: Authorization: Token token=&quot;9f2c4a7e…f7a490&quot;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A1B9A;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="900" y="978" width="900" height="112" as="geometry"/></mxCell><mxCell id="v45" value="BigQuery&lt;br&gt;7.3 writeback_log (append)&lt;br&gt;writer@ = dataEditor&lt;br&gt;on this table only" style="shape=mxgraph.gcp2.hexIcon;prIcon=bigquery;fillColor=#4284F3;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1994" y="264" width="72" height="72" as="geometry"/></mxCell><mxCell id="v46" value="&lt;b&gt;8.4 Read path&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F9A825;strokeWidth=2;fontSize=13;align=center;verticalAlign=top;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1880" y="500" width="300" height="142" as="geometry"/></mxCell><mxCell id="v47" value="&lt;b style=&quot;color:#B07A14&quot;&gt;8.4&lt;/b&gt;&amp;nbsp; view current_state = latest row" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1892" y="540" width="276" height="40" as="geometry"/></mxCell><mxCell id="v48" value="&lt;b style=&quot;color:#B07A14&quot;&gt;8.4&lt;/b&gt;&amp;nbsp; dashboard re-runs, shows value" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1892" y="588" width="276" height="40" as="geometry"/></mxCell><mxCell id="e49" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0078D4;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1.0000;exitY=0.5660;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.2096;entryDx=0;entryDy=0;startArrow=none;" edge="1" parent="1" source="v8" target="v11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v50" value="1.1" style="rounded=1;arcSize=50;html=1;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="226" width="38" height="28" as="geometry"/></mxCell><mxCell id="e51" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0078D4;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.6886;entryDx=0;entryDy=0;dashed=1;dashPattern=8 5;startArrow=block;startFill=1;" edge="1" parent="1" source="v10" target="v11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="476"/><mxPoint x="380" y="420"/></Array></mxGeometry></mxCell><mxCell id="v52" value="0.1–0.3" style="rounded=1;arcSize=50;html=1;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="252" y="482" width="70" height="28" as="geometry"/></mxCell><mxCell id="e53" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00897B;strokeWidth=2.5;endArrow=block;endFill=1;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;dashed=1;dashPattern=8 5;startArrow=none;" edge="1" parent="1" source="v11" target="v19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v54" value="config" style="rounded=1;arcSize=50;html=1;fillColor=#00897B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="632" y="528" width="62" height="28" as="geometry"/></mxCell><mxCell id="e55" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00897B;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1.0000;exitY=0.4192;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.3256;entryDx=0;entryDy=0;startArrow=none;" edge="1" parent="1" source="v11" target="v22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v56" value="1.3" style="rounded=1;arcSize=50;html=1;fillColor=#00897B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="818" y="294" width="38" height="28" as="geometry"/></mxCell><mxCell id="e57" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00897B;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1.0000;exitY=0.3256;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.3256;entryDx=0;entryDy=0;startArrow=none;" edge="1" parent="1" source="v22" target="v23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e58" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#FB8C00;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1.0000;exitY=0.8605;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.4737;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="v23" target="v36"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1420" y="560"/><mxPoint x="1420" y="610"/></Array></mxGeometry></mxCell><mxCell id="v59" value="2.1–2.3" style="rounded=1;arcSize=50;html=1;fillColor=#FB8C00;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1300" y="634" width="70" height="28" as="geometry"/></mxCell><mxCell id="e60" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6A1B9A;strokeWidth=2.5;endArrow=block;endFill=1;exitX=0.1053;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="v23" target="v41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v61" value="3.1" style="rounded=1;arcSize=50;html=1;fillColor=#6A1B9A;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1052" y="720" width="38" height="28" as="geometry"/></mxCell><mxCell id="e62" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2E7D32;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1.0000;exitY=0.2093;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.4737;entryDx=0;entryDy=0;startArrow=none;" edge="1" parent="1" source="v23" target="v32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v63" value="6.2" style="rounded=1;arcSize=50;html=1;fillColor=#2E7D32;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1390" y="244" width="38" height="28" as="geometry"/></mxCell><mxCell id="e64" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#FB8C00;strokeWidth=2.5;endArrow=block;endFill=1;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="v32" target="v36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v65" value="6.1 · 7.1" style="rounded=1;arcSize=50;html=1;fillColor=#FB8C00;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1637" y="436" width="86" height="28" as="geometry"/></mxCell><mxCell id="e66" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#F9A825;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1.0000;exitY=0.5789;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;startArrow=none;" edge="1" parent="1" source="v32" target="v45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v67" value="7.2" style="rounded=1;arcSize=50;html=1;fillColor=#F9A825;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1860" y="264" width="38" height="28" as="geometry"/></mxCell><mxCell id="e68" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00897B;strokeWidth=2.5;endArrow=block;endFill=1;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;dashed=1;dashPattern=8 5;startArrow=none;" edge="1" parent="1" source="v32" target="v11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1625" y="150"/><mxPoint x="620" y="150"/></Array></mxGeometry></mxCell><mxCell id="v69" value="8.1–8.2 result → Looker shows “success”" style="rounded=1;arcSize=50;html=1;fillColor=#00897B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1240" y="156" width="340" height="28" as="geometry"/></mxCell><mxCell id="v70" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:6px;&quot;&gt;Sub-steps (1 of 2)&lt;/div&gt;&lt;table style=&quot;border-collapse:collapse;font-size:13px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;0 Sign-in&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 8px;vertical-align:top;&quot;&gt;0.1 User opens Looker; Looker redirects to Entra (SAML).&lt;br&gt;0.2 Entra signs the user in (MFA, Conditional Access): authentication only.&lt;br&gt;0.3 Looker opens the session; built-in user attributes email and id are known.&lt;br&gt;0.4 A Looker admin has added the user to the manual group “Writeback Users”.&lt;br&gt;0.5 That group sets user attribute writeback_allowed = yes (default no; users can’t see or edit it). Only this group’s role can use the action.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;1 Click&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 8px;vertical-align:top;&quot;&gt;1.1 User edits a value and clicks “Write back” on the tagged field.&lt;br&gt;1.2 Looker’s server (never the browser) builds the payload once per click: rows, form values and the attributes writeback_allowed, email, id resolved at that moment.&lt;br&gt;1.3 Looker POSTs to the Write-back API with Authorization: Token token=&quot;&amp;lt;secret&amp;gt;&quot;.&lt;br&gt;1.4 Spoke 2 → HUB → Spoke 1 internal LB; firewall and NetworkPolicy allow only Looker; Looker trusts the internal CA of writeback-api.internal.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;2 Pod identity&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 8px;vertical-align:top;&quot;&gt;2.1 Write-back API asks the GKE metadata server for a Google token.&lt;br&gt;2.2 Workload Identity maps writeback-ksa → writeback-api@.&lt;br&gt;2.3 Token valid about 1 hour, refreshed automatically by the client library.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;3 Caller check&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 8px;vertical-align:top;&quot;&gt;3.1 API reads looker-action-secret from Secret Manager (cached 5 min).&lt;br&gt;3.2 Compares it with the header in constant time.&lt;br&gt;3.3 Missing or wrong → 401, audit event, stop.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;4 User check&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 8px;vertical-align:top;&quot;&gt;4.1 API reads writeback_allowed, email and id from the payload (trusted: step 3 proved it is Looker).&lt;br&gt;4.2 writeback_allowed must be “yes”, i.e. the user is in “Writeback Users” right now.&lt;br&gt;4.3 Anything else → 403, audit event, stop.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=top;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="40" y="1140" width="1060" height="400" as="geometry"/></mxCell><mxCell id="v71" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:6px;&quot;&gt;Sub-steps (2 of 2)&lt;/div&gt;&lt;table style=&quot;border-collapse:collapse;font-size:13px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;5 Validate&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 8px;vertical-align:top;&quot;&gt;5.1 Schema, allowed columns, value ranges, max rows, table allowed.&lt;br&gt;5.2 request_id (from Looker or generated) used as the idempotency key.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;6 Call Writer&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 8px;vertical-align:top;&quot;&gt;6.1 API gets a Google ID token for audience https://writer.internal as writeback-api@.&lt;br&gt;6.2 POST /v1/write with Bearer ID token; body: rows, actor email and id, request_id.&lt;br&gt;6.3 Writer verifies signature, audience and caller email = writeback-api@; else 403.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;7 Write&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 8px;vertical-align:top;&quot;&gt;7.1 Writer gets its own token as writer@ (Workload Identity).&lt;br&gt;7.2 Appends rows to writeback_log with insertId = request_id; a retry of the same request is dropped as a duplicate.&lt;br&gt;7.3 writer@ has dataEditor on writeback_log only.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;8 Result&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 8px;vertical-align:top;&quot;&gt;8.1 200 Writer → API → Looker.&lt;br&gt;8.2 Looker shows “success” and can refresh the query.&lt;br&gt;8.3 Audit record in Cloud Logging: request_id, user email and id, table, rows, outcome.&lt;br&gt;8.4 Dashboard reads the current_state view and shows the new value.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=top;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1140" y="1140" width="1060" height="400" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>