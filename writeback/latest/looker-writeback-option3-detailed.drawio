<mxfile host="app.diagrams.net"><diagram id="d1" name="Option 3 · detailed"><mxGraphModel dx="2240" dy="1580" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2240" pageHeight="1580" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;Looker write-back — Option 3: Looker action secret + Looker group + Workload Identity (detailed)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=24;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2160" height="50" as="geometry"/></mxCell><mxCell id="v2" value="Users sign in to Looker with Entra (SAML, authentication only). Permission to write = membership of the manual Looker group “Writeback Users”, which gives writeback_allowed = yes. Looker’s server calls the Write-back API with its action secret; every hop after that uses Google service accounts (Workload Identity). Solid = request, dashed = response." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=15;align=left;verticalAlign=middle;spacing=10;fontColor=#455A64;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="2160" height="34" as="geometry"/></mxCell><mxCell id="v3" value="① Internal user &amp;amp; Entra ID" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0078D4;strokeWidth=1.5;fontSize=15;align=left;verticalAlign=top;spacing=10;fontColor=#1F2A33;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="320" height="980" as="geometry"/></mxCell><mxCell id="v4" value="② Spoke 2 · Looker (GKE)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=1.5;fontSize=15;align=left;verticalAlign=top;spacing=10;fontColor=#1F2A33;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="120" width="440" height="980" as="geometry"/></mxCell><mxCell id="v5" value="③ Spoke 1 · GKE Tooling · namespace writeback" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=15;align=left;verticalAlign=top;spacing=10;fontColor=#1F2A33;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="120" width="940" height="640" as="geometry"/></mxCell><mxCell id="v6" value="④ Google Cloud services" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=1.5;fontSize=15;align=right;verticalAlign=top;spacing=10;fontColor=#1F2A33;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="790" width="940" height="310" as="geometry"/></mxCell><mxCell id="v7" value="⑤ BigQuery" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;strokeWidth=1.5;fontSize=15;align=left;verticalAlign=top;spacing=10;fontColor=#1F2A33;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1860" y="120" width="340" height="980" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b&gt;Internal user&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;fontSize=13;align=center;verticalAlign=top;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="70" y="200" width="260" height="106" as="geometry"/></mxCell><mxCell id="v9" value="&lt;b style=&quot;color:#0078D4&quot;&gt;1.1&lt;/b&gt;&amp;nbsp; edits a value, clicks “Write back”" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0078D4;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="82" y="240" width="236" height="52" as="geometry"/></mxCell><mxCell id="v10" value="Entra ID&lt;br&gt;0.2 SAML sign-in (MFA)&lt;br&gt;authentication only" style="shape=mxgraph.azure.azure_active_directory;fillColor=#0078D4;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="164" y="440" width="72" height="72" as="geometry"/></mxCell><mxCell id="v11" value="&lt;b&gt;Looker&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00897B;strokeWidth=2;fontSize=13;align=center;verticalAlign=top;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="430" y="190" width="380" height="334" as="geometry"/></mxCell><mxCell id="v12" value="&lt;b style=&quot;color:#00897B&quot;&gt;0.1&lt;/b&gt;&amp;nbsp; redirects user to Entra (SAML login)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="442" y="230" width="356" height="40" as="geometry"/></mxCell><mxCell id="v13" value="&lt;b style=&quot;color:#00897B&quot;&gt;0.3&lt;/b&gt;&amp;nbsp; session; built-in attributes email, id" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="442" y="278" width="356" height="40" as="geometry"/></mxCell><mxCell id="v14" value="&lt;b style=&quot;color:#00897B&quot;&gt;0.4&lt;/b&gt;&amp;nbsp; user is in group “Writeback Users”" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="442" y="326" width="356" height="40" as="geometry"/></mxCell><mxCell id="v15" value="&lt;b style=&quot;color:#00897B&quot;&gt;0.5&lt;/b&gt;&amp;nbsp; group value → writeback_allowed = yes" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="442" y="374" width="356" height="40" as="geometry"/></mxCell><mxCell id="v16" value="&lt;b style=&quot;color:#00897B&quot;&gt;1.2&lt;/b&gt;&amp;nbsp; Looker server (not browser) builds payload" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="442" y="422" width="356" height="40" as="geometry"/></mxCell><mxCell id="v17" value="&lt;b style=&quot;color:#00897B&quot;&gt;1.3&lt;/b&gt;&amp;nbsp; POST once per click + action secret" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="442" y="470" width="356" height="40" as="geometry"/></mxCell><mxCell id="v18" value="" style="image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="760" y="196" width="36" height="36" as="geometry"/></mxCell><mxCell id="v19" value="&lt;b&gt;Admin › Platform › Actions&lt;/b&gt;&lt;br&gt;Action hub URL:&lt;br&gt;https://writeback-api.internal&lt;br&gt;Authorization token =&lt;br&gt;&lt;b&gt;looker-action-secret&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00897B;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=10;fontColor=#1F2A33;dashed=1;" vertex="1" parent="1"><mxGeometry x="430" y="560" width="380" height="140" as="geometry"/></mxCell><mxCell id="v20" value="&lt;b&gt;Admin › Users › Groups&lt;/b&gt; (manual)&lt;br&gt;“Writeback Users”: members added by a Looker admin&lt;br&gt;&lt;b&gt;Admin › User Attributes&lt;/b&gt; › writeback_allowed&lt;br&gt;default &lt;i&gt;no&lt;/i&gt; · group value for Writeback Users = &lt;i&gt;yes&lt;/i&gt;&lt;br&gt;user access: None (users can’t see or change it)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00897B;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=10;fontColor=#1F2A33;dashed=1;" vertex="1" parent="1"><mxGeometry x="430" y="720" width="380" height="150" as="geometry"/></mxCell><mxCell id="v21" value="&lt;b&gt;Action shown only if&lt;/b&gt;&lt;br&gt;action enabled (Admin › Actions) · field tag &lt;i&gt;writeback_key&lt;/i&gt;&lt;br&gt;· user’s role has &lt;i&gt;send_to_integration&lt;/i&gt;&lt;br&gt;(hides the button; the API is the real check)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00897B;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=10;fontColor=#1F2A33;dashed=1;" vertex="1" parent="1"><mxGeometry x="430" y="890" width="380" height="140" as="geometry"/></mxCell><mxCell id="v22" value="&lt;b&gt;1.4&lt;/b&gt;&lt;br&gt;&lt;br&gt;ILB&lt;br&gt;+&lt;br&gt;FW&lt;br&gt;+&lt;br&gt;NetPol&lt;br&gt;&lt;br&gt;TLS:&lt;br&gt;Looker&lt;br&gt;trusts&lt;br&gt;internal&lt;br&gt;CA" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="900" y="190" width="70" height="430" as="geometry"/></mxCell><mxCell id="v23" value="&lt;b&gt;Write-back API (writeback-ksa)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;fontSize=13;align=center;verticalAlign=top;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1000" y="190" width="380" height="430" as="geometry"/></mxCell><mxCell id="v24" value="&lt;b style=&quot;color:#2E7D32&quot;&gt;3.2&lt;/b&gt;&amp;nbsp; compare action secret (constant time)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1012" y="230" width="356" height="40" as="geometry"/></mxCell><mxCell id="v25" value="&lt;b style=&quot;color:#2E7D32&quot;&gt;3.3&lt;/b&gt;&amp;nbsp; wrong or missing → 401" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1012" y="278" width="356" height="40" as="geometry"/></mxCell><mxCell id="v26" value="&lt;b style=&quot;color:#2E7D32&quot;&gt;4.1&lt;/b&gt;&amp;nbsp; read writeback_allowed, email, id" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1012" y="326" width="356" height="40" as="geometry"/></mxCell><mxCell id="v27" value="&lt;b style=&quot;color:#2E7D32&quot;&gt;4.2&lt;/b&gt;&amp;nbsp; writeback_allowed must be “yes”" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1012" y="374" width="356" height="40" as="geometry"/></mxCell><mxCell id="v28" value="&lt;b style=&quot;color:#2E7D32&quot;&gt;4.3&lt;/b&gt;&amp;nbsp; otherwise → 403" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1012" y="422" width="356" height="40" as="geometry"/></mxCell><mxCell id="v29" value="&lt;b style=&quot;color:#2E7D32&quot;&gt;5.1&lt;/b&gt;&amp;nbsp; validate rows, columns, limits" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1012" y="470" width="356" height="40" as="geometry"/></mxCell><mxCell id="v30" value="&lt;b style=&quot;color:#2E7D32&quot;&gt;5.2&lt;/b&gt;&amp;nbsp; set request_id (idempotency)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1012" y="518" width="356" height="40" as="geometry"/></mxCell><mxCell id="v31" value="&lt;b style=&quot;color:#2E7D32&quot;&gt;6.2&lt;/b&gt;&amp;nbsp; POST /v1/write to Writer" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1012" y="566" width="356" height="40" as="geometry"/></mxCell><mxCell id="v32" value="&lt;b&gt;Writer API (writer-ksa)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;fontSize=13;align=center;verticalAlign=top;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1460" y="190" width="330" height="190" as="geometry"/></mxCell><mxCell id="v33" value="&lt;b style=&quot;color:#2E7D32&quot;&gt;6.3&lt;/b&gt;&amp;nbsp; verify Google ID token = writeback-api@" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1472" y="230" width="306" height="40" as="geometry"/></mxCell><mxCell id="v34" value="&lt;b style=&quot;color:#2E7D32&quot;&gt;7.2&lt;/b&gt;&amp;nbsp; append row, insertId = request_id" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1472" y="278" w