2;fontSize=16;fontStyle=1;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3210.0" y="3710" as="sourcePoint"/><mxPoint x="3514.0" y="3710" as="targetPoint"/><mxPoint as="offset" y="-4"/></mxGeometry></mxCell><mxCell id="s95" value="&lt;b&gt;6.3&lt;/b&gt;&amp;nbsp; Tenant rows only" style="html=1;endArrow=block;endFill=1;endSize=12;strokeWidth=4;dashed=1;dashPattern=8 6;strokeColor=#005353;fontColor=#005353;fontSize=16;fontStyle=1;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3514.0" y="3790" as="sourcePoint"/><mxPoint x="3210.0" y="3790" as="targetPoint"/><mxPoint as="offset" y="-4"/></mxGeometry></mxCell><mxCell id="s96" value="&lt;b&gt;6.4&lt;/b&gt;&amp;nbsp; Dashboard 42 rendered in the WebApp" style="html=1;endArrow=block;endFill=1;endSize=12;strokeWidth=4;dashed=1;dashPattern=8 6;strokeColor=#255A12;fontColor=#255A12;fontSize=16;fontStyle=1;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3210.0" y="3870" as="sourcePoint"/><mxPoint x="170.0" y="3870" as="targetPoint"/><mxPoint as="offset" y="-4"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="m" name="2. State Machine"><mxGraphModel dx="2400" dy="1320" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1320" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="m1" value="&lt;b&gt;Behaviour View 2 — State machine: one dashboard request&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontSize=28;fontColor=#1F1F1F;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="2300" height="40" as="geometry"/></mxCell><mxCell id="m2" value="States a single request passes through. Custom-API states run on the CaaS cluster; Looker calls go through the Reverse Proxy. Any failed check ends in REJECTED or FAILED (fail-closed)." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontSize=15;fontColor=#444;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="2300" height="40" as="geometry"/></mxCell><mxCell id="m3" value="&lt;b style=&quot;font-size:17px&quot;&gt;RECEIVED&lt;/b&gt;&lt;br&gt;Looker API (Spoke 1) receives the call; X-Request-Id assigned" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DDE5F4;strokeColor=#12355B;strokeWidth=3;fontSize=13;fontColor=#1F1F1F;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="330" height="120" as="geometry"/></mxCell><mxCell id="m4" value="&lt;b style=&quot;font-size:17px&quot;&gt;TOKEN_EXTRACTED&lt;/b&gt;&lt;br&gt;Bearer JWT + X-Partner-Id parsed" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DDE5F4;strokeColor=#12355B;strokeWidth=3;fontSize=13;fontColor=#1F1F1F;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="470" y="150" width="330" height="120" as="geometry"/></mxCell><mxCell id="m5" value="&lt;b style=&quot;font-size:17px&quot;&gt;VALIDATING&lt;/b&gt;&lt;br&gt;Token Validation API (CaaS): ID&amp;amp;A via Apigee + JWKS (deadline 2 s)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#C5CAE9;strokeColor=#283593;strokeWidth=3;fontSize=13;fontColor=#1F1F1F;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="880" y="150" width="330" height="120" as="geometry"/></mxCell><mxCell id="m6" value="&lt;b style=&quot;font-size:17px&quot;&gt;VALIDATED&lt;/b&gt;&lt;br&gt;sub = X-Partner-Id; claims trusted" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#C5CAE9;strokeColor=#283593;strokeWidth=3;fontSize=13;fontColor=#1F1F1F;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1290" y="150" width="330" height="120" as="geometry"/></mxCell><mxCell id="m7" value="&lt;b style=&quot;font-size:17px&quot;&gt;RESOLVING_PARTNER&lt;/b&gt;&lt;br&gt;Partner Details API (CaaS) → Cloud SQL: tenant, groups, folders, role" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#C5CAE9;strokeColor=#283593;strokeWidth=3;fontSize=13;fontColor=#1F1F1F;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1700" y="150" width="330" height="120" as="geometry"/></mxCell><mxCell id="m8" value="&lt;b style=&quot;font-size:17px&quot;&gt;LISTING_DASHBOARDS&lt;/b&gt;&lt;br&gt;Partner Details API → ① login + folders/dashboards via Reverse Proxy" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#C5CAE9;strokeColor=#283593;strokeWidth=3;fontSize=13;fontColor=#1F1F1F;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1700" y="430" width="330" height="120" as="geometry"/></mxCell><mxCell id="m9" value="&lt;b style=&quot;font-size:17px&quot;&gt;SIGNING&lt;/b&gt;&lt;br&gt;Embed URL API (CaaS) → ② login + sso_url via Reverse Proxy" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#C5CAE9;strokeColor=#283593;strokeWidth=3;fontSize=13;fontColor=#1F1F1F;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1290" y="430" width="330" height="120" as="geometry"/></mxCell><mxCell id="m10" value="&lt;b style=&quot;font-size:17px&quot;&gt;URL_RETURNED&lt;/b&gt;&lt;br&gt;embed_url + dashboards[] returned to the WebApp" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DDE5F4;strokeColor=#12355B;strokeWidth=3;fontSize=13;fontColor=#1F1F1F;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="880" y="430" width="330" height="120" as="geometry"/></mxCell><mxCell id="m11" value="&lt;b style=&quot;font-size:17px&quot;&gt;OPENED&lt;/b&gt;&lt;br&gt;Browser opens the signed URL (embed door → Spoke 2)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE699;strokeColor=#8C6A00;strokeWidth=3;fontSize=13;fontColor=#1F1F1F;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="470" y="430" width="330" height="120" as="geometry"/></mxCell><mxCell id="m12" value="&lt;b style=&quot;font-size:17px&quot;&gt;RENDERED&lt;/b&gt;&lt;br&gt;Looker renders dashboard; rows filtered by tenant" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#255A12;strokeWidth=3;fontSize=13;fontColor=#1F1F1F;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="430" width="330" height="120" as="geometry"/></mxCell><mxCell id="m13" value="&lt;b style=&quot;font-size:17px&quot;&gt;REJECTED&lt;/b&gt;&lt;br&gt;401 / 403 returned, or Looker refuses the URL; AUTH_DENIED / ACCESS_DENIED audited" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDE9E7;strokeColor=#C00000;strokeWidth=3;fontSize=13;fontColor=#1F1F1F;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="1150" height="120" as="geometry"/></mxCell><mxCell id="m14" value="&lt;b style=&quot;font-size:17px&quot;&gt;FAILED&lt;/b&gt;&lt;br&gt;502 / 503 / 504 returned; ROUTE_FAILED or DEPENDENCY_FAILED audited" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDE9E7;strokeColor=#C00000;strokeWidth=3;fontSize=13;fontColor=#1F1F1F;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1290" y="760" width="350" height="120" as="geometry"/></mxCell><mxCell id="m15" value="headers parsed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#12355B;strokeWidth=3;endArrow=block;endFill=1;endSize=8;fontSize=12;fontStyle=1;fontColor=#12355B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m3" target="m4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m16" value="well-formed JWT → call CaaS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#283593;strokeWidth=3;endArrow=block;endFill=1;endSize=8;fontSize=12;fontStyle=1;fontColor=#283593;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m4" target="m5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m17" value="valid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#283593;strokeWidth=3;endArrow=block;endFill=1;endSize=8;fontSize=12;fontStyle=1;fontColor=#283593;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m5" target="m6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m18" value="partner id ok" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#283593;strokeWidth=3;endArrow=block;endFill=1;endSize=8;fontSize=12;fontStyle=1;fontColor=#283593;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m6" target="m7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m19" value="active partner + tenant" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#283593;strokeWidth=3;endArrow=block;endFill=1;endSize=8;fontSize=12;fontStyle=1;fontColor=#283593;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m7" target="m8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m20" value="dashboards found" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#283593;strokeWidth=3;endArrow=block;endFill=1;endSize=8;fontSize=12;fontStyle=1;fontColor=#283593;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m8" target="m9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m21" value="signed URL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#283593;strokeWidth=3;endArrow=block;endFill=1;endSize=8;fontSize=12;fontStyle=1;fontColor=#283593;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m9" target="m10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m22" value="iframe.src" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#12355B;strokeWidth=3;endArrow=block;endFill=1;endSize=8;fontSize=12;fontStyle=1;fontColor=#12355B;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m10" target="m11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m23" value="signature ok" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#255A12;strokeWidth=3;endArrow=block;endFill=1;endSize=8;fontSize=12;fontStyle=1;fontColor=#255A12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m11" target="m12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m24" value="no / malformed token → 401" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C00000;strokeWidth=3;endArrow=block;endFill=1;endSize=8;fontSize=12;fontStyle=1;fontColor=#C00000;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.3217391304347826;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=8 5;" edge="1" parent="1" source="m4" target="m13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="536" y="300"/><mxPoint x="430" y="300"/></Array></mxGeometry></mxCell><mxCell id="m25" value="invalid / expired → 401" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C00000;strokeWidth=3;endArrow=block;endFill=1;endSize=8;fontSize=12;fontStyle=1;fontColor=#C00000;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.6782608695652174;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=8 5;" edge="1" parent="1" source="m5" target="m13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="946" y="320"/><mxPoint x="840" y="320"/></Array></mxGeometry></mxCell><mxCell id="m26" value="signature / nonce / domain fail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C00000;strokeWidth=3;endArrow=block;endFill=1;endSize=8;fontSize=12;fontStyle=1;fontColor=#C00000;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=8 5;" edge="1" parent="1" source="m11" target="m13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m27" value="unknown / disabled / suspended → 403" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C00000;strokeWidth=3;endArrow=block;endFill=1;endSize=8;fontSize=12;fontStyle=1;fontColor=#C00000;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.83;entryDx=0;entryDy=0;dashed=1;dashPattern=8 5;" edge="1" parent="1" source="m7" target="m13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2090" y="210"/><mxPoint x="2090" y="950"/><mxPoint x="1235" y="950"/><mxPoint x="1235" y="860"/></Array></mxGeometry></mxCell><mxCell id="m28" value="no dashboards → 403" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C00000;strokeWidth=3;endArrow=block;endFill=1;endSize=8;fontSize=12;fontStyle=1;fontColor=#C00000;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.45;entryDx=0;entryDy=0;dashed=1;dashPattern=8 5;" edge="1" parent="1" source="m8" target="m13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1865" y="920"/><mxPoint x="1260" y="920"/><mxPoint x="1260" y="814"/></Array></mxGeometry></mxCell><mxCell id="m29" value="ID&amp;amp;A timeout after retry → 503" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C00000;strokeWidth=3;endArrow=block;endFill=1;endSize=8;fontSize=12;fontStyle=1;fontColor=#C00000;labelBackgroundColor=#FFFFFF;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=8 5;" edge="1" parent="1" source="m5" target="m14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1144" y="340"/><mxPoint x="1250" y="340"/><mxPoint x="1250" y="730"/><mxPoint x="1325" y="730"/></Array></mxGeometry></mxCell><mxCell id="m30" value="RP / Looker error → 502" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C00000;strokeWidth=3;endArrow=block;endFill=1;endSize=8;fontSize=12;fontStyle=1;fontColor=#C00000;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.47;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=8 5;" edge="1" parent="1" source="m9" target="m14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m31" value="&lt;b&gt;Invariants&lt;/b&gt;&lt;br&gt;• No transition past VALIDATED without a verified JWT – auth is never bypassed, even when ID&amp;amp;A is unavailable.&lt;br&gt;• Tenant, groups and folders come only from Cloud SQL (RESOLVING_PARTNER), never from the request.&lt;br&gt;• SIGNING only for a dashboard returned by LISTING_DASHBOARDS; the CaaS cluster never calls Looker directly – both Looker calls go through the Reverse Proxy.&lt;br&gt;• Every state transition is logged with the same X-Request-Id; the signed URL and tokens are never logged.&lt;br&gt;• Timeouts: whole request 8 s; ID&amp;amp;A 2 s (retry ×1); each Looker call 3 s." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#595959;strokeWidth=2;fontSize=15;fontColor=#1F1F1F;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="1000" width="2280" height="220" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="a" name="3. Activity (swimlanes)"><mxGraphModel dx="2948" dy="1580" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2948" pageHeight="1580" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="a1" value="&lt;b&gt;Behaviour View 3 — Activity (swimlanes): who does what, with decisions&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontSize=28;fontColor=#1F1F1F;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="2888" height="40" as="geometry"/></mxCell><mxCell id="a2" value="Each lane is one actor. Diamonds are checks; any “No” goes to the red lane and is audited with the X-Request-Id." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontSize=15;fontColor=#444;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="2888" height="40" as="geometry"/></mxCell><mxCell id="a3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#A0430A;strokeWidth=2;fontSize=14;fontColor=#1F1F1F;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="2888" height="150" as="geometry"/></mxCell><mxCell id="a4" value="&lt;b&gt;User&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A0430A;strokeColor=#A0430A;strokeWidth=2;fontSize=15;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="190" height="150" as="geometry"/></mxCell><mxCell id="a5" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#8C6A00;strokeWidth=2;fontSize=14;fontColor=#1F1F1F;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="270" width="2888" height="150" as="geometry"/></mxCell><mxCell id="a6" value="&lt;b&gt;WebApp&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8C6A00;strokeColor=#8C6A00;strokeWidth=2;fontSize=15;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacin