html=1;strokeColor=#F9A825;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1.0000;exitY=0.2500;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.3472;entryDx=0;entryDy=0;startArrow=none;" edge="1" parent="1" source="v36" target="v38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v86" value="6.7" style="rounded=1;arcSize=50;html=1;fillColor=#F9A825;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2600" y="1080" width="38" height="28" as="geometry"/></mxCell><mxCell id="e87" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#F9A825;strokeWidth=2.5;endArrow=block;endFill=1;exitX=0.0000;exitY=0.8333;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;dashed=1;dashPattern=8 5;startArrow=none;" edge="1" parent="1" source="v38" target="v36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v88" value="6.8" style="rounded=1;arcSize=50;html=1;fillColor=#F9A825;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2600" y="1158" width="38" height="28" as="geometry"/></mxCell><mxCell id="e89" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#AD1457;strokeWidth=2.5;endArrow=block;endFill=1;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.2222;entryY=1.0000;entryDx=0;entryDy=0;dashed=1;dashPattern=8 5;startArrow=none;" edge="1" parent="1" source="v36" target="v9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2395" y="1320"/><mxPoint x="130" y="1320"/></Array></mxGeometry></mxCell><mxCell id="v90" value="6.9" style="rounded=1;arcSize=50;html=1;fillColor=#AD1457;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="142" y="1170" width="38" height="28" as="geometry"/></mxCell><mxCell id="v91" value="6.9 rendered dashboard returns to the iframe along the same path (Looker → ILB → HUB → Reverse Proxy → External LB)" style="rounded=1;arcSize=50;html=1;fillColor=#AD1457;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1050" y="1326" width="820" height="28" as="geometry"/></mxCell><mxCell id="v92" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:6px;&quot;&gt;Step table&lt;/div&gt;&lt;table style=&quot;border-collapse:collapse;font-size:14px;width:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;5.0&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;WebApp → Looker API&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;&quot;&gt;Authorization: Bearer &amp;lt;JWT&amp;gt;, X-Partner-Id: PRT-ACME-0071. The caller never sends tenant, groups or folders.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;5.1&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;Verify the caller&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;&quot;&gt;JWT checked with ID&amp;amp;A public keys (JWKS, cached 5 min): signature, expiry, issuer, audience. X-Partner-Id must equal sub. Fail → 401/403.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;5.2&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;Looker API → Partner Details API&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;&quot;&gt;GET /internal/partners/PRT-ACME-0071/details&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;5.3&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;Read the Tenant Registry&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;&quot;&gt;Through the Auth Proxy sidecar (private IP, IAM login) one query returns tenant acme, statuses, max_role, business_groups retail, home 42, external_user_id PRT-ACME-0071::acme, groups {17,31}, folders {512,530}. Unknown / disabled / suspended → 403.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;5.4&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;List what the user may open&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;&quot;&gt;Read-only Looker key from Secret Manager (5.4a) → login → GET /api/4.0/folders/{512,530}/dashboards through the API door, HUB and Spoke 2 ILB → 42, 43, 44. None → 403.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;5.5&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;Details back to Looker API&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;&quot;&gt;partner, tenant, effective role (JWT role capped at max_role), group_ids, business_groups, external_user_id, dashboards[], home_dashboard_id.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;5.6a&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;Pick the landing dashboard&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;&quot;&gt;Asked-for (must be allowed) → tenant home → “Home” → lowest id. Result 42.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;5.6&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;Looker API → Embed URL API&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;&quot;&gt;POST /internal/embed-url with the details and dashboard 42. Embed URL API re-checks 42 is allowed.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;5.7&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;Signing key&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;&quot;&gt;looker-embed API3 client id / secret read from Secret Manager via Workload Identity.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;5.8&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;Ask Looker to sign&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;&quot;&gt;POST /api/4.0/embed/sso_url (body on the right) through the API door → HUB → Looker.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;5.9&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;Signed URL returned&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;&quot;&gt;Looker signs with its embed secret, adds nonce and time. Single use, valid for minutes.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;5.10&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;Back to Looker API&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;&quot;&gt;embed_url handed to the Looker API; the backend never opens, logs or stores it.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;5.11&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;Back to WebApp&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;&quot;&gt;{ embed_url, dashboards[42,43,44], home_dashboard_id 42, session_length 3600 } → WebApp builds its menu.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;6.1&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;Set the iframe&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;&quot;&gt;WebApp sets iframe.src = embed_url.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;6.2&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;Browser opens the URL once&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;&quot;&gt;GET https://analytics.partners.example/login/embed/… → External HTTPS LB → Reverse Proxy embed door.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;6.3&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;Transit to Looker&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;&quot;&gt;Embed door → HUB (HA VPN, Cloud Router) → Spoke 2 Internal LB → Looker.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;6.4&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;Looker checks the URL&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;&quot;&gt;Signature, time, nonce not reused, parent page on the embed domain allowlist. Mismatch → frame refused.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;6.5&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;User, groups, attributes&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;&quot;&gt;Finds user by PRT-ACME-0071::acme (first login creates 2381). Groups set to exactly 17 and 31. tenant_id = acme, business_group = retail. Session cookie set, redirect to dashboard 42.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;6.6&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;Folder permission&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;&quot;&gt;Group 17 may view folder 512 where dashboard 42 lives; otherwise refused.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;6.7&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;Row filter&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;&quot;&gt;Every tile query gets WHERE tenant_id = &#x27;acme&#x27; AND business_group = &#x27;retail&#x27; (LookML access_filter) and runs on BigQuery.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;6.8&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;Rows back&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;&quot;&gt;Only acme / retail rows are returned.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;6.9&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;Dashboard on screen&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;&quot;&gt;Dashboard 42 renders in the iframe.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;6.10&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;white-space:nowrap;&quot;&gt;&lt;b&gt;Switching&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;&quot;&gt;Menu click sets iframe.src = /embed/dashboards/44; Looker checks group 31 → folder 530 and shows it. New signed URL only after the 3600 s session ends.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="40" y="1400" width="1300" height="720" as="geometry"/></mxCell><mxCell id="v93" value="&lt;b&gt;5.8&amp;nbsp;&amp;nbsp;POST https://looker-api.rp.internal/api/4.0/embed/sso_url&lt;/b&gt;&lt;br&gt;Authorization: token &amp;lt;looker-embed access token&amp;gt;&lt;br&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;target_url&quot;: &quot;https://analytics.partners.example/embed/dashboards/42&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; ?embed_domain=https://portal.partners.example&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;external_user_id&quot;:&amp;nbsp;&amp;nbsp; &quot;PRT-ACME-0071::acme&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;first_name&quot;: &quot;Jane&quot;, &quot;last_name&quot;: &quot;Doe&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;group_ids&quot;:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;[&quot;17&quot;, &quot;31&quot;],&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;external_group_id&quot;:&amp;nbsp;&amp;nbsp;&quot;acme&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;user_attributes&quot;:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{ &quot;tenant_id&quot;: &quot;acme&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;business_group&quot;: &quot;retail&quot; },&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;permissions&quot;:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;[&quot;access_data&quot;, &quot;see_user_dashboards&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &quot;see_looks&quot;, &quot;explore&quot;],&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;models&quot;:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; [&quot;partner_analytics&quot;],&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;session_length&quot;:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 3600,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;force_logout_login&quot;: true&lt;br&gt;}&lt;br&gt;&lt;br&gt;&lt;b&gt;5.9&amp;nbsp;&amp;nbsp;200 OK&lt;/b&gt;&lt;br&gt;{ &quot;url&quot;: &quot;https://analytics.partners.example/login/embed/&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;%2Fembed%2Fdashboards%2F42...&amp;amp;nonce=...&amp;amp;time=...&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;amp;signature=...&quot; }&lt;br&gt;&lt;br&gt;&lt;b&gt;6.1&amp;nbsp;&amp;nbsp;WebApp&lt;/b&gt;&lt;br&gt;document.getElementById(&quot;looker&quot;).src = embed_url;&lt;br&gt;&lt;br&gt;&lt;b&gt;6.10&amp;nbsp;&amp;nbsp;switch dashboard (same session)&lt;/b&gt;&lt;br&gt;iframe.src = &quot;https://analytics.partners.example/embed/dashboards/44&quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; + &quot;?embed_domain=https://portal.partners.example&quot;;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A1B9A;strokeWidth=2;fontSize=14;align=left;verticalAlign=top;spacing=10;fontColor=#1F2A33;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1370" y="1400" width="760" height="720" as="geometry"/></mxCell><mxCell id="v94" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:6px;&quot;&gt;Registry → signed URL → Looker&lt;/div&gt;&lt;table style=&quot;border-collapse:collapse;font-size:14px;width:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px;&quot;&gt;&lt;b&gt;Cloud SQL&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 6px;&quot;&gt;&lt;b&gt;Signed URL field&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 6px;&quot;&gt;&lt;b&gt;Decides&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px;border-top:1px solid #CFD8DC;&quot;&gt;partner_users.looker_external_user_id&lt;/td&gt;&lt;td style=&quot;padding:4px 6px;border-top:1px solid #CFD8DC;&quot;&gt;external_user_id&lt;/td&gt;&lt;td style=&quot;padding:4px 6px;border-top:1px solid #CFD8DC;&quot;&gt;which Looker user (new or existing)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px;border-top:1px solid #CFD8DC;&quot;&gt;partner_groups → tenant_groups&lt;/td&gt;&lt;td style=&quot;padding:4px 6px;border-top:1px solid #CFD8DC;&quot;&gt;group_ids [17, 31]&lt;/td&gt;&lt;td style=&quot;padding:4px 6px;border-top:1px solid #CFD8DC;&quot;&gt;which folders → which dashboards&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px;border-top:1px solid #CFD8DC;&quot;&gt;group_folders&lt;/td&gt;&lt;td style=&quot;padding:4px 6px;border-top:1px solid #CFD8DC;&quot;&gt;(checked before signing)&lt;/td&gt;&lt;td style=&quot;padding:4px 6px;border-top:1px solid #CFD8DC;&quot;&gt;allowed dashboard list&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px;border-top:1px solid #CFD8DC;&quot;&gt;tenants.tenant_id&lt;/td&gt;&lt;td style=&quot;padding:4px 6px;border-top:1px solid #CFD8DC;&quot;&gt;user_attributes.tenant_id&lt;/td&gt;&lt;td style=&quot;padding:4px 6px;border-top:1px solid #CFD8DC;&quot;&gt;rows: tenant filter&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px;border-top:1px solid #CFD8DC;&quot;&gt;partner_users.business_groups&lt;/td&gt;&lt;td style=&quot;padding:4px 6px;border-top:1px solid #CFD8DC;&quot;&gt;user_attributes.business_group&lt;/td&gt;&lt;td style=&quot;padding:4px 6px;border-top:1px solid #CFD8DC;&quot;&gt;rows: business group filter&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px;border-top:1px solid #CFD8DC;&quot;&gt;max_role → role_capabilities&lt;/td&gt;&lt;td style=&quot;padding:4px 6px;border-top:1px solid #CFD8DC;&quot;&gt;permissions, models&lt;/td&gt;&lt;td style=&quot;padding:4px 6px;border-top:1px solid #CFD8DC;&quot;&gt;what the user can do&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 6px;border-top:1px solid #CFD8DC;&quot;&gt;tenants.home_dashboard_id&lt;/td&gt;&lt;td style=&quot;padding:4px 6px;border-top:1px solid #CFD8DC;&quot;&gt;target_url /dashboards/42&lt;/td&gt;&lt;td style=&quot;padding:4px 6px;border-top:1px solid #CFD8DC;&quot;&gt;first dashboard shown&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="2160" y="1400" width="700" height="400" as="geometry"/></mxCell><mxCell id="v95" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:6px;&quot;&gt;Controls&lt;/div&gt;• Tenant, groups and filters come only from the registry, keyed by the verified JWT sub&lt;br&gt;• Checked twice: API before signing, Looker on every open and switch&lt;br&gt;• Signed URL: single use, minutes valid, opened only by the browser&lt;br&gt;• Looker reached only through the Reverse Proxy; Spoke 1 → Spoke 2 always via HUB&lt;br&gt;• Cloud SQL private IP, IAM login; Looker keys in Secret Manager via Workload Identity&lt;br&gt;• Fail closed: any missing piece → 403, never a default" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EF6C00;strokeWidth=2;fontSize=14;align=left;verticalAlign=top;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="2160" y="1820" width="700" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>