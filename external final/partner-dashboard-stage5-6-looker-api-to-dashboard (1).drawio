<mxfile host="app.diagrams.net"><diagram id="stage56" name="Looker API to dashboard"><mxGraphModel dx="2900" dy="2160" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2900" pageHeight="2160" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;Stage 5 &amp;amp; 6 — from the Looker API call to the dashboard on screen&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=26;align=left;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2820" height="56" as="geometry"/></mxCell><mxCell id="v2" value="Scope: the user is already logged in to the WebApp and ID&amp;amp;A has validated the token through the Apigee internal proxy. Example: partner &lt;b&gt;PRT-ACME-0071&lt;/b&gt;, tenant &lt;b&gt;acme&lt;/b&gt;, business group &lt;b&gt;retail&lt;/b&gt;. Solid arrows = request, dashed = response. Numbers match the step table below." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=15;align=left;verticalAlign=middle;spacing=10;fontColor=#455A64;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="2820" height="34" as="geometry"/></mxCell><mxCell id="v3" value="① Partner user · Browser &amp;amp; WebApp" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#AD1457;strokeWidth=1.5;fontSize=15;align=left;verticalAlign=top;spacing=10;fontColor=#1F2A33;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="330" height="1240" as="geometry"/></mxCell><mxCell id="v4" value="② Spoke 1 VPC · Tooling project" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;strokeWidth=1.5;fontSize=15;align=left;verticalAlign=top;spacing=10;fontColor=#1F2A33;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="120" width="1380" height="1240" as="geometry"/></mxCell><mxCell id="v5" value="③ HUB VPC" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;strokeWidth=1.5;fontSize=15;align=left;verticalAlign=top;spacing=10;fontColor=#1F2A33;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1810" y="120" width="260" height="1240" as="geometry"/></mxCell><mxCell id="v6" value="④ Spoke 2 VPC · Looker project" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00838F;strokeWidth=1.5;fontSize=15;align=left;verticalAlign=top;spacing=10;fontColor=#1F2A33;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2100" y="120" width="500" height="1240" as="geometry"/></mxCell><mxCell id="v7" value="⑤ Data" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;strokeWidth=1.5;fontSize=15;align=left;verticalAlign=top;spacing=10;fontColor=#1F2A33;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2630" y="120" width="230" height="1240" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b&gt;WebApp&lt;/b&gt;&lt;br&gt;portal.partners.example&lt;br&gt;&lt;br&gt;&lt;b&gt;5.0&lt;/b&gt; calls Looker API with&lt;br&gt;&lt;i&gt;Bearer JWT + X-Partner-Id&lt;/i&gt;&lt;br&gt;&lt;b&gt;5.11&lt;/b&gt; gets embed_url + dashboards[]&lt;br&gt;builds its own menu:&lt;br&gt;Home · Monthly Revenue · Retail KPIs" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AD1457;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="70" y="250" width="270" height="240" as="geometry"/></mxCell><mxCell id="v9" value="&lt;b&gt;Browser iframe&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;6.1&lt;/b&gt; iframe.src = embed_url&lt;br&gt;&lt;b&gt;6.2&lt;/b&gt; one GET to the signed URL&lt;br&gt;&lt;b&gt;6.9&lt;/b&gt; dashboard 42 shown,&lt;br&gt;filtered to acme / retail&lt;br&gt;&lt;br&gt;&lt;b&gt;6.10&lt;/b&gt; menu click → iframe.src =&lt;br&gt;/embed/dashboards/44&lt;br&gt;&lt;i&gt;(same session, no new signed URL)&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AD1457;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="70" y="600" width="270" height="290" as="geometry"/></mxCell><mxCell id="v10" value="GKE Tooling cluster · namespace partner-api · private nodes" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=top;spacing=10;fontColor=#1F2A33;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="160" width="1340" height="770" as="geometry"/></mxCell><mxCell id="v11" value="" style="shape=mxgraph.gcp2.hexIcon;prIcon=container_engine;fillColor=#4284F3;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1690" y="166" width="40" height="40" as="geometry"/></mxCell><mxCell id="v12" value="Pod: partner-details-api" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=bottom;spacing=10;fontColor=#1F2A33;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="775" y="250" width="310" height="395" as="geometry"/></mxCell><mxCell id="v13" value="&lt;b&gt;Looker API&lt;/b&gt; (orchestrator)&lt;br&gt;&lt;br&gt;&lt;b&gt;5.0&lt;/b&gt; receives the call&lt;br&gt;&lt;b&gt;5.1&lt;/b&gt; verifies JWT with cached ID&amp;amp;A JWKS: signature, exp, iss, aud&lt;br&gt;X-Partner-Id must equal sub&lt;br&gt;→ else 401 / 403" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0277BD;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="450" y="265" width="280" height="190" as="geometry"/></mxCell><mxCell id="v14" value="&lt;b&gt;5.6a Landing dashboard&lt;/b&gt;&lt;br&gt;1 dashboard asked for (must be allowed)&lt;br&gt;2 tenant home_dashboard_id&lt;br&gt;3 dashboard titled “Home”&lt;br&gt;4 lowest id&lt;br&gt;→ &lt;b&gt;42&lt;/b&gt; · not allowed → 403" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="450" y="525" width="280" height="180" as="geometry"/></mxCell><mxCell id="v15" value="&lt;b&gt;Partner Details API&lt;/b&gt;&lt;br&gt;GET /internal/partners/{id}/details&lt;br&gt;&lt;b&gt;5.3&lt;/b&gt; reads the registry (Q1)&lt;br&gt;&lt;b&gt;5.4&lt;/b&gt; lists dashboards per folder&lt;br&gt;&lt;b&gt;5.5&lt;/b&gt; returns details + dashboards[]" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="790" y="265" width="280" height="160" as="geometry"/></mxCell><mxCell id="v16" value="&lt;b&gt;Cloud SQL Auth Proxy&lt;/b&gt; (sidecar)&lt;br&gt;127.0.0.1:5432 · private IP&lt;br&gt;IAM login · no password" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="790" y="525" width="280" height="90" as="geometry"/></mxCell><mxCell id="v17" value="&lt;b&gt;Embed URL API&lt;/b&gt;&lt;br&gt;POST /internal/embed-url&lt;br&gt;re-checks 42 ∈ allowed list&lt;br&gt;&lt;b&gt;5.7&lt;/b&gt; reads looker-embed key&lt;br&gt;&lt;b&gt;5.8&lt;/b&gt; POST /api/4.0/embed/sso_url&lt;br&gt;&lt;b&gt;5.9&lt;/b&gt; gets signed URL&lt;br&gt;&lt;i&gt;never opens, logs or stores it&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1130" y="265" width="290" height="185" as="geometry"/></mxCell><mxCell id="v18" value="&lt;b&gt;Reverse Proxy (NGINX)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=top;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1490" y="265" width="250" height="600" as="geometry"/></mxCell><mxCell id="v19" value="&lt;b&gt;API door :19999&lt;/b&gt;&lt;br&gt;looker-api.rp.internal&lt;br&gt;internal callers only&lt;br&gt;resolves looker.*.internal&lt;br&gt;via DNS peering" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F9A825;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1510" y="305" width="210" height="200" as="geometry"/></mxCell><mxCell id="v20" value="&lt;b&gt;Embed door :9999&lt;/b&gt;&lt;br&gt;analytics.partners.example&lt;br&gt;only from External LB&lt;br&gt;passes /login/embed/*&lt;br&gt;and /embed/*" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F9A825;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1510" y="620" width="210" height="200" as="geometry"/></mxCell><mxCell id="v21" value="Secret Manager&lt;br&gt;looker-ro · looker-embed&lt;br&gt;API3 client id / secret" style="shape=mxgraph.gcp2.hexIcon;prIcon=cloud_security_scanner;fillColor=#4284F3;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="454" y="1010" width="72" height="72" as="geometry"/></mxCell><mxCell id="v22" value="Workload Identity&lt;br&gt;KSA → GSA · secretAccessor&lt;br&gt;cloudsql.client · instanceUser" style="shape=mxgraph.gcp2.hexIcon;prIcon=cloud_iam;fillColor=#4284F3;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="704" y="1010" width="72" height="72" as="geometry"/></mxCell><mxCell id="v23" value="Tenant Registry · Cloud SQL&lt;br&gt;partner_users · partner_groups&lt;br&gt;tenant_groups · group_folders" style="shape=mxgraph.gcp2.hexIcon;prIcon=cloud_sql;fillColor=#4284F3;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="894" y="1010" width="72" height="72" as="geometry"/></mxCell><mxCell id="v24" value="Cloud Logging&lt;br&gt;audit events&lt;br&gt;(signed URL never logged)" style="shape=mxgraph.gcp2.hexIcon;prIcon=cloud_logging;fillColor=#4284F3;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1204" y="1010" width="72" height="72" as="geometry"/></mxCell><mxCell id="v25" value="External HTTPS LB&lt;br&gt;analytics.partners.example&lt;br&gt;public embed host · TLS" style="shape=mxgraph.gcp2.hexIcon;prIcon=cloud_load_balancing;fillColor=#4284F3;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1579" y="1010" width="72" height="72" as="geometry"/></mxCell><mxCell id="v26" value="HA VPN +&lt;br&gt;Cloud Router (BGP)" style="shape=mxgraph.gcp2.hexIcon;prIcon=cloud_vpn;fillColor=#4284F3;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1904" y="170" width="72" height="72" as="geometry"/></mxCell><mxCell id="v27" value="&lt;b&gt;Transit&lt;/b&gt;&lt;br&gt;&lt;br&gt;Spoke 1&lt;br&gt;⇄&lt;br&gt;HUB&lt;br&gt;⇄&lt;br&gt;Spoke 2&lt;br&gt;&lt;br&gt;IPsec tunnels&lt;br&gt;HUB router&lt;br&gt;re-advertises&lt;br&gt;spoke routes" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#EF6C00;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1880" y="330" width="120" height="480" as="geometry"/></mxCell><mxCell id="v28" value="Hub Cloud DNS&lt;br&gt;looker.*.internal&lt;br&gt;(DNS peering)" style="shape=mxgraph.gcp2.hexIcon;prIcon=cloud_dns;fillColor=#4284F3;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="1904" y="910" width="72" height="72" as="geometry"/></mxCell><mxCell id="v29" value="Spoke 2&lt;br&gt;Internal LB" style="shape=mxgraph.gcp2.hexIcon;prIcon=cloud_load_balancing;fillColor=#4284F3;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="2119" y="170" width="64" height="64" as="geometry"/></mxCell><mxCell id="v30" value="ILB" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#B2EBF2;strokeColor=#00838F;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=10;fontColor=#1F2A33;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2120" y="330" width="64" height="480" as="geometry"/></mxCell><mxCell id="v31" value="GKE Looker cluster" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00838F;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=top;spacing=10;fontColor=#1F2A33;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2210" y="160" width="370" height="1080" as="geometry"/></mxCell><mxCell id="v32" value="" style="image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="2518" y="168" width="44" height="44" as="geometry"/></mxCell><mxCell id="v33" value="&lt;b&gt;Looker · API 4.0&lt;/b&gt;&lt;br&gt;&lt;b&gt;5.4&lt;/b&gt; GET /folders/512/dashboards&lt;br&gt;GET /folders/530/dashboards&lt;br&gt;→ 42, 43, 44&lt;br&gt;&lt;b&gt;5.8&lt;/b&gt; POST /embed/sso_url&lt;br&gt;signs with the embed secret,&lt;br&gt;adds nonce + time → &lt;b&gt;5.9&lt;/b&gt; URL" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00838F;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="2230" y="330" width="330" height="190" as="geometry"/></mxCell><mxCell id="v34" value="&lt;b&gt;Embed login&lt;/b&gt; /login/embed/…&lt;br&gt;&lt;b&gt;6.4&lt;/b&gt; signature valid · time fresh&lt;br&gt;nonce not used before&lt;br&gt;parent page on embed allowlist&lt;br&gt;&lt;b&gt;6.5&lt;/b&gt; find user by external_user_id&lt;br&gt;PRT-ACME-0071::acme&lt;br&gt;(first login → creates user 2381)&lt;br&gt;groups = [17, 31], others removed&lt;br&gt;tenant_id = acme · business_group = retail&lt;br&gt;session cookie → /embed/dashboards/42" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00838F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="2230" y="590" width="330" height="250" as="geometry"/></mxCell><mxCell id="v35" value="&lt;b&gt;6.6 Folder permission&lt;/b&gt;&lt;br&gt;42 in folder 512 Partners/acme&lt;br&gt;(View: group 17)&lt;br&gt;44 in folder 530 …/Retail (View: group 31)&lt;br&gt;anything else → refused" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00838F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=10;fontColor=#1F2A33;" vertex="1" parent="1"><mxGeometry x="2230" y="890" width="330" height="140" as="geometry"/></mxCell><mxCell id="v36" value="&lt;b&gt;6.7 Query with LookML access_filter&lt;/b&gt;&lt;br&gt;WHERE tenant_id = &#x27;acme&#x27;&lt;br&gt;AND business_group = &#x27;retail&#x27;&lt;br&gt;runs as Looker’s BigQuery connection" style="rounded=1;arcSiz