<mxCell id="x_e54a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;flowAnimation=1;jumpStyle=arc;jumpSize=12;dashed=1;strokeColor=#4284F3;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="x_det" target="x_smro"><mxGeometry relative="1" as="geometry" /></mxCell>
