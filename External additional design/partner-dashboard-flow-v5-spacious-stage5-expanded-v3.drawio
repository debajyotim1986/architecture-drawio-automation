<mxCell id="t1" value="audit: auth events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;flowAnimation=1;labelBackgroundColor=#ffffff;labelBorderColor=none;spacing=4;dashed=1;strokeColor=#999999;strokeWidth=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="idaapi" target="logging"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1130" y="1258" /></Array><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
<mxCell id="t2" value="audit: dashboard activity" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;flowAnimation=1;labelBackgroundColor=#ffffff;labelBorderColor=none;spacing=4;dashed=1;strokeColor=#999999;strokeWidth=1;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="looker" target="logging"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1620" y="948" /><mxPoint x="1620" y="1258" /></Array><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
<mxCell id="t3" value="audit: API + auth calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;flowAnimation=1;labelBackgroundColor=#ffffff;labelBorderColor=none;spacing=4;dashed=1;strokeColor=#999999;strokeWidth=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="lookerapi" target="logging"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="388" y="1060" /><mxPoint x="1130" y="1060" /><mxPoint x="1130" y="1200" /><mxPoint x="1468" y="1200" /></Array><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
<mxCell id="t4" value="alerts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;flowAnimation=1;labelBackgroundColor=#ffffff;labelBorderColor=none;spacing=4;dashed=1;strokeColor=#4284F3;strokeWidth=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="logging" target="monitor"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
<mxCell id="b1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#4284F3;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="400" y="150" width="34" height="34" as="geometry" /></mxCell>
<mxCell id="b2" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#4284F3;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="400" y="215" width="34" height="34" as="geometry" /></mxCell>
<mxCell id="b3" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0288D1;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1000" y="130" width="34" height="34" as="geometry" /></mxCell>
<mxCell id="b4" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#8E24AA;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="230" y="870" width="34" height="34" as="geometry" /></mxCell>
<mxCell id="b5" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#00897B;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="860" width="34" height="34" as="geometry" /></mxCell>
<mxCell id="b6" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#EA4335;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="2020" y="95" width="34" height="34" as="geometry" /></mxCell>
<mxCell id="stg" value="STAGE SUMMARY — HUB ↔ each Spoke over HA VPN (IPsec) with Cloud Router BGP on both ends; Hub Cloud DNS + per-spoke Cloud DNS joined by DNS peering.&#10;1 — User logs in to the WebApp (session + JWT).   2 — User clicks &quot;Open Dashboard&quot;.&#10;3 — WebApp attaches the JWT and calls the Looker API on GKE: PSC endpoint → Hub ILB → HA VPN tunnel (routes learned via BGP) → SPOKE 1 Tooling cluster.&#10;4 — Looker API FIRST calls ID&amp;A auth through the Apigee Internal Proxy (PSC), passing the JWT; ID&amp;A returns the result.&#10;5 — On OK, Looker API routes via the Reverse Proxy: 5a Spoke-1 DNS resolves the Looker FQDN via DNS peering to Hub DNS (which peers to Spoke-2's zone); 5b traffic goes Spoke-1 VPN → HUB, Hub Cloud Router re-advertises Spoke-2 routes (transit) → VPN → SPOKE 2 ILB → Looker pods.&#10;6 — Dashboard rendered back to the user. Login, auth and dashboard activity traced by Cloud Logging → Monitoring." style="text;html=1;fontSize=12;align=left;spacing=10;fillColor=#FFF3E0;strokeColor=#FB8C00;rounded=1;" vertex="1" parent="1"><mxGeometry x="60" y="1420" width="2020" height="175" as="geometry" /></mxCell>
<mxCell id="x_region" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#455A64;strokeWidth=2;dashed=1;arcSize=1;" vertex="1" parent="1"><mxGeometry x="60" y="1700" width="2440" height="3660.0" as="geometry" /></mxCell>
<mxCell id="x_title" value="&lt;b&gt;STAGE 5 EXPANDED — what happens after the Looker API (Layer 3a) is called&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Numbers in circles match the numbered text in each box. Connectors carry no text so nothing overlaps; every step is explained inside its box.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;" vertex="1" parent="1"><mxGeometry x="560" y="1712" width="1900" height="64" as="geometry" /></mxCell>
<mxCell id="x_O" value="&lt;b&gt;LOOKER API — orchestrator (Spoke 1 · Tooling GKE)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=16;fillColor=#FFFDE7;strokeColor=#F9A825;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="100" y="1800" width="420" height="1200" as="geometry" /></mxCell>
<mxCell id="x_la" value="Looker API&lt;br&gt;(same service as Layer 3a)" style="shape=mxgraph.gcp2.hexIcon;prIcon=container_engine;fillColor=#4284F3;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="266" y="1860" width="88" height="88" as="geometry" /></mxCell>
<mxCell id="x_Ot" value="Runs these steps in order:&lt;br&gt;&lt;br&gt;① 5.1&amp;nbsp;&amp;nbsp;verify the JWT (JWKS)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; X-Partner-Id must equal sub&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; → else 401 / 403, stop&lt;br&gt;&lt;br&gt;② 5.2&amp;nbsp;&amp;nbsp;call Partner Details API&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; ← 5.5&amp;nbsp;&amp;nbsp;tenant_id, status, role,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;group_id, folder_id,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;dashboards[], home id&lt;br&gt;&lt;br&gt;③ 5.6&amp;nbsp;&amp;nbsp;call Embed URL API&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; with the details + home id&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; ← 5.10 embed_url (signed,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;single use)&lt;br&gt;&lt;br&gt;④ 5.11 return to the WebApp:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; embed_url + dashboards[]&lt;br&gt;&lt;br&gt;Fail closed at every step:&lt;br&gt;nothing reaches the WebApp&lt;br&gt;unless all checks pass." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12.5;fontFamily=Courier New;fillColor=#FFFFFF;strokeColor=#FFE082;fontColor=#1F2A33;arcSize=3;" vertex="1" parent="1"><mxGeometry x="120" y="2010" width="380" height="960" as="geometry" /></mxCell>
<mxCell id="x_R1" value="&lt;b&gt;5.1 · VERIFY THE CALLER — ID&amp;amp;A public keys (JWKS)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=16;fillColor=#F3E5F5;strokeColor=#8E24AA;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="640" y="1800" width="1820" height="240" as="geometry" /></mxCell>
<mxCell id="x_jwks" value="ID&amp;amp;A JWKS&lt;br&gt;/.well-known/jwks.json" style="shape=mxgraph.gcp2.hexIcon;prIcon=cloud_iam;fillColor=#4284F3;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="1860" width="88" height="88" as="geometry" /></mxCell>
<mxCell id="x_R1t" value="GET https://ida.internal/.well-known/jwks.json&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(public keys, cached 5 min — no ID&amp;amp;A call per request)&lt;br&gt;Checks on the Bearer JWT:&amp;nbsp;&amp;nbsp;signature · exp not passed · iss = https://ida.internal/ · aud = partner-data-api&lt;br&gt;X-Partner-Id header must equal the JWT sub (PRT-ACME-0071), otherwise 403.&lt;br&gt;ID&amp;amp;A itself was already asked to validate the user in Stage 4; this step makes the Looker API verify the token on its own." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#FFFFFF;strokeColor=#CE93D8;fontColor=#1F2A33;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1000" y="1850" width="1440" height="170" as="geometry" /></mxCell>
<mxCell id="x_R2" value="&lt;b&gt;5.2 – 5.5 · PARTNER DETAILS API&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=16;fillColor=#E6F4EA;strokeColor=#34A853;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="640" y="2100" width="1820" height="420" as="geometry" /></mxCell>
<mxCell id="x_det" value="Partner Details API&lt;br&gt;GET /internal/partners/{id}/details" style="shape=mxgraph.gcp2.hexIcon;prIcon=container_engine;fillColor=#4284F3;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="2170" width="88" height="88" as="geometry" /></mxCell>
<mxCell id="x_reg" value="Tenant Registry&lt;br&gt;Cloud SQL (private IP)" style="shape=mxgraph.gcp2.hexIcon;prIcon=cloud_sql;fillColor=#4284F3;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1300" y="2170" width="88" height="88" as="geometry" /></mxCell>
<mxCell id="x_smro" value="Secret Manager&lt;br&gt;looker-ro client id / secret" style="shape=mxgraph.gcp2.hexIcon;prIcon=cloud_security_scanner;fillColor=#4284F3;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="2370" width="88" height="88" as="geometry" /></mxCell>
<mxCell id="x_rp1" value="Reverse Proxy&lt;br&gt;API door (existing)" style="shape=mxgraph.gcp2.hexIcon;prIcon=cloud_network;fillColor=#4284F3;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1300" y="2370" width="88" height="88" as="geometry" /></mxCell>
<mxCell id="x_lk1" value="Looker (Spoke 2)&lt;br&gt;API 4.0" style="image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1900" y="2370" width="88" height="88" as="geometry" /></mxCell>
<mxCell id="x_R2t" value="5.2&amp;nbsp;&amp;nbsp;GET /internal/partners/PRT-ACME-0071/details&lt;br&gt;5.3&amp;nbsp;&amp;nbsp;Cloud SQL → tenant_id, status, max_role,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; looker_group_id, looker_folder_id&amp;nbsp;&amp;nbsp;(cache 60 s)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; unknown / disabled / suspended → 403&lt;br&gt;5.4a read-only Looker API key (Secret Manager)&lt;br&gt;5.4&amp;nbsp;&amp;nbsp;GET /api/4.0/folders/512/dashboards&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; → [42 Home, 43 Monthly Revenue, 44 …]&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; path: Reverse Proxy → 5a DNS → 5b HUB → Spoke 2&lt;br&gt;5.5&amp;nbsp;&amp;nbsp;details returned to the Looker API" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fontFamily=Courier New;fillColor=#FFFFFF;strokeColor=#A5D6A7;fontColor=#1F2A33;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1560" y="2140" width="880" height="215" as="geometry" /></mxCell>
<mxCell id="x_R3" value="&lt;b&gt;5.6 – 5.10 · EMBED URL API (creates the signed URL, never opens it)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=16;fillColor=#E1F5FE;strokeColor=#0288D1;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="640" y="2580" width="1820" height="420" as="geometry" /></mxCell>
<mxCell id="x_emb" value="Embed URL API&lt;br&gt;POST /internal/embed-url" style="shape=mxgraph.gcp2.hexIcon;prIcon=container_engine;fillColor=#4284F3;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="2650" width="88" height="88" as="geometry" /></mxCell>
<mxCell id="x_rp2" value="Reverse Proxy&lt;br&gt;API door (existing)" style="shape=mxgraph.gcp2.hexIcon;prIcon=cloud_network;fillColor=#4284F3;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1300" y="2650" width="88" height="88" as="geometry" /></mxCell>
<mxCell id="x_lk2" value="Looker (Spoke 2)&lt;br&gt;API 4.0" style="image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1900" y="2650" width="88" height="88" as="geometry" /></mxCell>
<mxCell id="x_smad" value="Secret Manager&lt;br&gt;looker-embed client id / secret" style="shape=mxgraph.gcp2.hexIcon;prIcon=cloud_security_scanner;fillColor=#4284F3;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="2850" width="88" height="88" as="geometry" /></mxCell>
<mxCell id="x_R3t" value="5.6&amp;nbsp;&amp;nbsp;input: external_user_id acme::PRT-ACME-0071 · group_ids [17] · user_attributes {tenant_id: acme}&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; permissions + models from role · dashboard_id 42 (Home) — must be in the tenant folder list&lt;br&gt;5.7&amp;nbsp;&amp;nbsp;Looker API key allowed to create signed URLs (Secret Manager)&lt;br&gt;5.8&amp;nbsp;&amp;nbsp;POST /api/4.0/login, then POST /api/4.0/embed/sso_url&amp;nbsp;&amp;nbsp; (full body below)&lt;br&gt;5.9&amp;nbsp;&amp;nbsp;Looker returns the signed URL&lt;br&gt;5.10 embed_url returned to the Looker API — the backend does NOT open it" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fontFamily=Courier New;fillColor=#FFFFFF;strokeColor=#81D4FA;fontColor=#1F2A33;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1060" y="2800" width="1380" height="180" as="geometry" /></mxCell>
<mxCell id="x_n1" value="Why Secret Manager holds a Looker client id + secret&lt;br&gt;&lt;br&gt;Looker API 4.0 does not accept Google IAM or the ID&amp;amp;A JWT. Every call first needs a Looker token from POST /api/4.0/login using the client id + secret (API3 key) of a Looker service user.&lt;br&gt;&lt;br&gt;Two service users, least privilege:&lt;br&gt;• looker-ro (5.4a) — list folders and dashboards only&lt;br&gt;• looker-embed (5.7) — allowed to create signed URLs&lt;br&gt;&lt;br&gt;Read once per pod through Workload Identity. Never in code, YAML or logs." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12.5;fillColor=#FFF3E0;strokeColor=#FB8C00;fontColor=#1F2A33;arcSize=3;" vertex="1" parent="1"><mxGeometry x="100" y="3060" width="420" height="420" as="geometry" /></mxCell>
<mxCell id="x_n2" value="One signed URL per login&lt;br&gt;&lt;br&gt;• The signed URL logs the user into Looker and opens ONE dashboard (Home, 42).&lt;br&gt;• The Looker session (3600 s) covers every dashboard in folder Partners/acme.&lt;br&gt;• Switching dashboards = the WebApp menu changes the iframe to /embed/dashboards/43. No new signed URL, no GKE call.&lt;br&gt;• A new signed URL is created only after the session expires or on a new login.&lt;br&gt;• The backend creates the URL; only the user&amp;#x27;s browser opens it." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12.5;fillColor=#FDECEA;strokeColor=#E53935;fontColor=#1F2A33;arcSize=3;" vertex="1" parent="1"><mxGeometry x="100" y="3520" width="420" height="420" as="geometry" /></mxCell>
<mxCell id="x_R4" value="&lt;b&gt;5.8 – 5.9 · SIGNED URL — COMBINED CODE AND HOW IT IS CALLED&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=16;fillColor=#E1F5FE;strokeColor=#0288D1;strokeWidth=2;arcSize=2;" vertex="1" parent="1"><mxGeometry x="640" y="3060" width="1820" height="1340" as="geometry" /></mxCell>
<mxCell id="x_R4t" value="5.8 + 5.9 · CREATE THE SIGNED URL — runs in the Embed URL API (Spoke 1 · Tooling GKE), through the Reverse Proxy API door to Looker (Spoke 2)&lt;br&gt;&lt;br&gt;────────── A · curl commands (runbook / testing) ──────────&lt;br&gt;# 5.7&amp;nbsp;&amp;nbsp;read the Looker API key from Secret Manager (the pod uses Workload Identity; same values)&lt;br&gt;CLIENT_ID=$(gcloud secrets versions access latest --secret=looker-embed-client-id)&lt;br&gt;CLIENT_SECRET=$(gcloud secrets versions access latest --secret=looker-embed-client-secret)&lt;br&gt;&lt;br&gt;# 5.8a&amp;nbsp;&amp;nbsp;log in to the Looker API → short-lived access token&lt;br&gt;TOKEN=$(curl -s -X POST &amp;quot;https://looker-api.rp.internal/api/4.0/login&amp;quot; \&lt;br&gt;&amp;nbsp;&amp;nbsp;--data-urlencode &amp;quot;client_id=${CLIENT_ID}&amp;quot; \&lt;br&gt;&amp;nbsp;&amp;nbsp;--data-urlencode &amp;quot;client_secret=${CLIENT_SECRET}&amp;quot; | jq -r .access_token)&lt;br&gt;&lt;br&gt;# 5.8b&amp;nbsp;&amp;nbsp;ask Looker to create and sign the embed URL&lt;br&gt;curl -s -X POST &amp;quot;https://looker-api.rp.internal/api/4.0/embed/sso_url&amp;quot; \&lt;br&gt;&amp;nbsp;&amp;nbsp;-H &amp;quot;Authorization: token ${TOKEN}&amp;quot; \&lt;br&gt;&amp;nbsp;&amp;nbsp;-H &amp;quot;Content-Type: application/json&amp;quot; \&lt;br&gt;&amp;nbsp;&amp;nbsp;-d &amp;#x27;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;quot;target_url&amp;quot;:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;quot;https://analytics.partners.example/embed/dashboards/42?embed_domain=https://portal.partners.example&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;quot;session_length&amp;quot;:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 3600,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;quot;force_logout_login&amp;quot;: true,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;quot;external_user_id&amp;quot;:&amp;nbsp;&amp;nbsp; &amp;quot;acme::PRT-ACME-0071&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;quot;first_name&amp;quot;:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;quot;Jane&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;quot;last_name&amp;quot;:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;quot;Doe&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;quot;user_timezone&amp;quot;:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;quot;Europe/London&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;quot;permissions&amp;quot;:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;[&amp;quot;access_data&amp;quot;,&amp;quot;see_user_dashboards&amp;quot;,&amp;quot;see_looks&amp;quot;,&amp;quot;explore&amp;quot;,&amp;quot;download_without_limit&amp;quot;],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;quot;models&amp;quot;:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; [&amp;quot;partner_analytics&amp;quot;],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;quot;group_ids&amp;quot;:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;[&amp;quot;17&amp;quot;],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;quot;external_group_id&amp;quot;:&amp;nbsp;&amp;nbsp;&amp;quot;acme&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;quot;user_attributes&amp;quot;:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{&amp;quot;tenant_id&amp;quot;: &amp;quot;acme&amp;quot;}&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;}&amp;#x27;&lt;br&gt;&lt;br&gt;# 5.9&amp;nbsp;&amp;nbsp;response from Looker&lt;br&gt;{ &amp;quot;url&amp;quot;: &amp;quot;https://analytics.partners.example/login/embed/%2Fembed%2Fdashboards%2F42%3Fembed_domain%3D…?nonce=%22…%22&amp;amp;time=1759064461&amp;amp;session_length=3600&amp;amp;external_user_id=%22acme%3A%3APRT-ACME-0071%22&amp;amp;…&amp;amp;signature=Wk1r…&amp;quot; }&lt;br&gt;&lt;br&gt;────────── B · Python — what the Embed URL API actually runs ──────────&lt;br&gt;import looker_sdk&lt;br&gt;from looker_sdk import models40 as m&lt;br&gt;&lt;br&gt;sdk = looker_sdk.init40()&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# LOOKERSDK_BASE_URL=https://looker-api.rp.internal + client id/secret from Secret Manager&lt;br&gt;resp = sdk.create_sso_embed_url(body=m.EmbedSsoParams(&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# = POST /api/4.0/embed/sso_url (5.8)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;target_url=&amp;quot;https://analytics.partners.example/embed/dashboards/42?embed_domain=https://portal.partners.example&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;session_length=3600, force_logout_login=True,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;external_user_id=&amp;quot;acme::PRT-ACME-0071&amp;quot;,&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# tenant_id::partner_id → new vs existing user&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;first_name=&amp;quot;Jane&amp;quot;, last_name=&amp;quot;Doe&amp;quot;, user_timezone=&amp;quot;Europe/London&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;permissions=[&amp;quot;access_data&amp;quot;, &amp;quot;see_user_dashboards&amp;quot;, &amp;quot;see_looks&amp;quot;, &amp;quot;explore&amp;quot;, &amp;quot;download_without_limit&amp;quot;],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;models=[&amp;quot;partner_analytics&amp;quot;],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;group_ids=[&amp;quot;17&amp;quot;], external_group_id=&amp;quot;acme&amp;quot;,&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# folder Partners/acme only&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;user_attributes={&amp;quot;tenant_id&amp;quot;: &amp;quot;acme&amp;quot;},&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; # row-level security key&lt;br&gt;))&lt;br&gt;embed_url = resp.url&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; # 5.9 → returned to the Looker API (5.10). Never log, cache or open it here.&lt;br&gt;&lt;br&gt;────────── C · How the signed URL is CALLED (6.1) — by the user&amp;#x27;s browser, exactly once ──────────&lt;br&gt;&amp;lt;!-- WebApp page --&amp;gt;&lt;br&gt;&amp;lt;iframe id=&amp;quot;looker&amp;quot; title=&amp;quot;Partner dashboard&amp;quot; style=&amp;quot;width:100%;height:85vh;border:0&amp;quot;&amp;gt;&amp;lt;/iframe&amp;gt;&lt;br&gt;&amp;lt;script&amp;gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;// embedUrl arrived from the Looker API at 5.11&lt;br&gt;&amp;nbsp;&amp;nbsp;document.getElementById(&amp;quot;looker&amp;quot;).src = embedUrl;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; // browser sends ONE GET to the signed URL&lt;br&gt;&amp;lt;/script&amp;gt;&lt;br&gt;&lt;br&gt;What the browser sends:&lt;br&gt;&amp;nbsp;&amp;nbsp;GET https://analytics.partners.example/login/embed/%2Fembed%2Fdashboards%2F42…&amp;amp;signature=Wk1r…&lt;br&gt;What Looker does and returns:&lt;br&gt;&amp;nbsp;&amp;nbsp;verifies signature · time · nonce · embed_domain → creates or reuses user acme::PRT-ACME-0071&lt;br&gt;&amp;nbsp;&amp;nbsp;→ redirect to /embed/dashboards/42 + Set-Cookie (Looker session, SameSite=None; Secure)&lt;br&gt;&amp;nbsp;&amp;nbsp;→ dashboard 42 renders in the iframe&lt;br&gt;&lt;br&gt;Test only (never in production code — the URL works once):&lt;br&gt;&amp;nbsp;&amp;nbsp;curl -si &amp;quot;&amp;lt;embed_url&amp;gt;&amp;quot; | head -20&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# expect a redirect + Set-Cookie; a second call is rejected (nonce used)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=12;fontFamily=Courier New;fillColor=#FFFFFF;strokeColor=#90CAF9;fontColor=#1F2A33;arcSize=1;" vertex="1" parent="1"><mxGeometry x="660" y="3110" width="1780" height="1270" as="geometry" /></mxCell>
<mxCell id="x_R5" value="&lt;b&gt;5.11 – 6.4 · WEBAPP SCREEN, LOOKER AND BIGQUERY&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=16;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="620" y="4440.0" width="1840" height="560" as="geometry" /></mxCell>
<mxCell id="x_mock" value="&lt;table style=&quot;width:100%;height:100%;border-collapse:collapse;font-size:12.5px;background:#ffffff&quot; border=&quot;1&quot; cellpadding=&quot;8&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;background:#0288D1;color:#ffffff&quot;&gt;&lt;b&gt;WebApp&lt;/b&gt; · Acme Ltd · Jane Doe&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:36%;vertical-align:top;background:#F5F7F8&quot;&gt;&lt;b&gt;MY DASHBOARDS&lt;/b&gt;&lt;br&gt;&lt;br&gt;▶ &lt;b&gt;Home&lt;/b&gt; (42) ●&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Monthly Revenue (43)&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Settlement Exceptions (44)&lt;br&gt;&lt;br&gt;&lt;i&gt;menu built by the WebApp from dashboards[] received at 5.11&lt;/i&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;background:#E0F2F1&quot;&gt;&lt;b&gt;LOOKER DASHBOARD (iframe)&lt;/b&gt;&lt;br&gt;&lt;br&gt;first open: iframe.src = embed_url&lt;br&gt;→ Looker login + Home (42)&lt;br&gt;&lt;br&gt;click “Monthly Revenue” in the menu:&lt;br&gt;iframe.src = /embed/dashboards/43&lt;br&gt;→ same Looker session, no new signed URL&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=none;strokeColor=#0288D1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="660" y="4500.0" width="720" height="440" as="geometry" /></mxCell>
<mxCell id="x_lk3" value="Looker (Spoke 2)&lt;br&gt;public embed door" style="image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1700" y="4580.0" width="88" height="88" as="geometry" /></mxCell>
<mxCell id="x_bq" value="BigQuery&lt;br&gt;partner_dwh" style="shape=mxgraph.gcp2.hexIcon;prIcon=bigquery;fillColor=#4284F3;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2300" y="4580.0" width="88" height="88" as="geometry" /></mxCell>
<mxCell id="x_62" value="6.1&amp;nbsp;&amp;nbsp;first open: browser loads the signed URL&lt;br&gt;6.2&amp;nbsp;&amp;nbsp;Looker checks: signature · time · nonce ·&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; parent origin on allowlist&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; external_user_id known → reuse user,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; unknown → create embed user&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; group 17 → only folder Partners/acme&lt;br&gt;6.4&amp;nbsp;&amp;nbsp;menu click: /embed/dashboards/43 opens in&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; the same session (folder access checked)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fontFamily=Courier New;fillColor=#FFFFFF;strokeColor=#FFE082;fontColor=#1F2A33;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1560" y="4730.0" width="600" height="250" as="geometry" /></mxCell>
<mxCell id="x_63" value="6.3&amp;nbsp;&amp;nbsp;every tile query&lt;br&gt;&lt;br&gt;WHERE tenant_id = &amp;#x27;acme&amp;#x27;&lt;br&gt;&lt;br&gt;added by Looker&lt;br&gt;(LookML access_filter)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fontFamily=Courier New;fillColor=#FFFFFF;strokeColor=#FFE082;fontColor=#1F2A33;arcSize=3;" vertex="1" parent="1"><mxGeometry x="2190" y="4730.0" width="250" height="250" as="geometry" /></mxCell>
<mxCell id="x_leg" value="How to read Stage 5&lt;br&gt;&lt;br&gt;● Numbered circles sit next to the connector they describe.&lt;br&gt;● Two-way arrows = request and its response.&lt;br&gt;● Dashed arrows = returns or credentials.&lt;br&gt;● &amp;quot;(existing)&amp;quot; = components already shown in the diagram above (Reverse Proxy, HUB path, Looker)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12.5;fillColor=#ECEFF1;strokeColor=#90A4AE;fontColor=#1F2A33;arcSize=3;" vertex="1" parent="1"><mxGeometry x="100" y="4440.0" width="420" height="380" as="geometry" /></mxCell>
<mxCell id="x_R6" value="&lt;b&gt;WHERE EACH STAGE RUNS · ENVIRONMENT VALUES  (example names — replace with yours)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=16;fillColor=#ECEFF1;strokeColor=#546E7A;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="100" y="5060.0" width="2360" height="270" as="geometry" /></mxCell>
<mxCell id="x_R6t" value="&lt;table border=&quot;1&quot; cellpadding=&quot;6&quot; style=&quot;border-collapse:collapse;font-size:12.5px;width:100%;background:#ffffff&quot;&gt;&lt;tr style=&quot;background:#CFD8DC&quot;&gt;&lt;th&gt;Stage&lt;/th&gt;&lt;th&gt;Component&lt;/th&gt;&lt;th&gt;Runs in&lt;/th&gt;&lt;th&gt;DEV&lt;/th&gt;&lt;th&gt;SIT&lt;/th&gt;&lt;th&gt;PROD&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5.1&lt;/td&gt;&lt;td&gt;ID&amp;amp;A JWKS&lt;/td&gt;&lt;td&gt;ID&amp;amp;A platform&lt;/td&gt;&lt;td&gt;ida.dev.internal&lt;/td&gt;&lt;td&gt;ida.sit.internal&lt;/td&gt;&lt;td&gt;ida.internal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5.2–5.6, 5.10–5.11&lt;/td&gt;&lt;td&gt;Looker API · Partner Details API · Embed URL API&lt;/td&gt;&lt;td&gt;Spoke 1 · Tooling GKE · ns partner-api&lt;/td&gt;&lt;td&gt;partner-api-dev&lt;/td&gt;&lt;td&gt;partner-api-sit&lt;/td&gt;&lt;td&gt;partner-api-prod&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5.3&lt;/td&gt;&lt;td&gt;Tenant Registry&lt;/td&gt;&lt;td&gt;Cloud SQL, private IP&lt;/td&gt;&lt;td&gt;tenant-registry-dev&lt;/td&gt;&lt;td&gt;tenant-registry-sit&lt;/td&gt;&lt;td&gt;tenant-registry&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5.4a · 5.7&lt;/td&gt;&lt;td&gt;Secret Manager&lt;/td&gt;&lt;td&gt;Spoke 1 project&lt;/td&gt;&lt;td&gt;lbg-partner-dev&lt;/td&gt;&lt;td&gt;lbg-partner-sit&lt;/td&gt;&lt;td&gt;lbg-partner-prod&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5.4 · 5.8–5.9&lt;/td&gt;&lt;td&gt;Looker API 4.0 via Reverse Proxy&lt;/td&gt;&lt;td&gt;Spoke 1 RP → HUB → Spoke 2&lt;/td&gt;&lt;td&gt;looker-api.rp.dev.internal&lt;/td&gt;&lt;td&gt;looker-api.rp.sit.internal&lt;/td&gt;&lt;td&gt;looker-api.rp.internal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6.1–6.4&lt;/td&gt;&lt;td&gt;Embed host / WebApp origin&lt;/td&gt;&lt;td&gt;External LB → RP embed door → Spoke 2&lt;/td&gt;&lt;td&gt;analytics.dev… / portal.dev…&lt;/td&gt;&lt;td&gt;analytics.sit… / portal.sit…&lt;/td&gt;&lt;td&gt;analytics.partners.example / portal.partners.example&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6.3&lt;/td&gt;&lt;td&gt;BigQuery dataset&lt;/td&gt;&lt;td&gt;Data project, private IP&lt;/td&gt;&lt;td&gt;partner_dwh_dev&lt;/td&gt;&lt;td&gt;partner_dwh_sit&lt;/td&gt;&lt;td&gt;partner_dwh&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="120" y="5105.0" width="2320" height="215" as="geometry" /></mxCell>
