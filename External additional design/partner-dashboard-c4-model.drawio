<mxCell id="title" value="&lt;b&gt;Level 1 — System Context: Partner Dashboard Access&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#666&quot;&gt;Who uses the system and which other systems it depends on&lt;/font&gt;" style="text;html=1;fontSize=20;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="60" as="geometry"/></mxCell>
<mxCell id="user" value="&lt;b&gt;External Partner User&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Authenticated partner who opens Looker dashboards from the WebApp&lt;/font&gt;" style="shape=mxgraph.c4.person2;html=1;fillColor=#08427B;strokeColor=none;fontColor=#ffffff;fontSize=13;align=center;verticalAlign=middle;spacingTop=30;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="80" y="240" width="200" height="180" as="geometry"/></mxCell>
<mxCell id="webapp" value="&lt;b&gt;Central WebApp&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Partner-facing portal. Holds the user session and JWT; exposes the &quot;Open Dashboard&quot; link.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=none;fontColor=#ffffff;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="420" y="270" width="260" height="130" as="geometry"/></mxCell>
<mxCell id="dash" value="&lt;b&gt;Partner Dashboard Platform&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Looker API + Reverse Proxy (Tooling GKE) and Looker (Looker GKE) across a hub-and-spoke network.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=none;fontColor=#ffffff;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="860" y="270" width="300" height="130" as="geometry"/></mxCell>
<mxCell id="apigee" value="&lt;b&gt;Apigee X&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;API management layer. Internal proxy fronts ID&amp;A for token verification.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=none;fontColor=#ffffff;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="860" y="540" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="ida" value="&lt;b&gt;ID&amp;A Platform&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Enterprise identity &amp; authentication. Issues and verifies JWTs.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=none;fontColor=#ffffff;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1180" y="540" width="220" height="110" as="geometry"/></mxCell>
