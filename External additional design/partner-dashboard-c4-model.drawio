<diagram id="c4-l2" name="L2 Container"><mxGraphModel dx="1620" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b&gt;Level 2 — Container: Partner Dashboard Platform&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#666&quot;&gt;Deployable units inside the system boundary and how requests flow between them&lt;/font&gt;" style="text;html=1;fontSize=20;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="60" as="geometry"/></mxCell>
<mxCell id="user" value="&lt;b&gt;External Partner User&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;/font&gt;" style="shape=mxgraph.c4.person2;html=1;fillColor=#08427B;strokeColor=none;fontColor=#ffffff;fontSize=13;align=center;verticalAlign=middle;spacingTop=30;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="200" height="180" as="geometry"/></mxCell>
<mxCell id="webapp" value="&lt;b&gt;Central WebApp&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Holds session + JWT; calls the platform&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=none;fontColor=#ffffff;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="200" height="110" as="geometry"/></mxCell>
<mxCell id="bnd" value="&lt;b&gt;Partner Dashboard Platform  [Software System]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#444444;dashed=1;strokeWidth=2;fontColor=#444444;fontSize=13;align=left;verticalAlign=bottom;spacingLeft=10;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="330" y="110" width="1250" height="700" as="geometry"/></mxCell>
<mxCell id="bhub" value="&lt;b&gt;HUB VPC&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#444444;dashed=1;strokeWidth=2;fontColor=#444444;fontSize=13;align=left;verticalAlign=bottom;spacingLeft=10;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="360" y="150" width="340" height="300" as="geometry"/></mxCell>
<mxCell id="hubilb" value="&lt;b&gt;Hub Entry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container: Internal LB + PSC]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Single private entry point for spokes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=none;fontColor=#ffffff;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="380" y="200" width="140" height="90" as="geometry"/></mxCell>
<mxCell id="hubvpn" value="&lt;b&gt;HA VPN + Cloud Router&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container: Networking]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;IPsec tunnels to each spoke; BGP re-advertises spoke↔spoke routes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=none;fontColor=#ffffff;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="540" y="200" width="140" height="90" as="geometry"/></mxCell>
<mxCell id="hubdns" value="&lt;b&gt;Hub Cloud DNS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container: DNS]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Peering target for spoke DNS zones&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=none;fontColor=#ffffff;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="380" y="320" width="140" height="90" as="geometry"/></mxCell>
<mxCell id="bs1" value="&lt;b&gt;SPOKE 1 VPC — Tooling GKE (shared)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#444444;dashed=1;strokeWidth=2;fontColor=#444444;fontSize=13;align=left;verticalAlign=bottom;spacingLeft=10;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="740" y="150" width="400" height="300" as="geometry"/></mxCell>
<mxCell id="api" value="&lt;b&gt;Looker API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container: GKE service]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Receives JWT; calls ID&amp;A via Apigee first; then routes to dashboard&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=none;fontColor=#ffffff;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="760" y="200" width="170" height="100" as="geometry"/></mxCell>
<mxCell id="rev" value="&lt;b&gt;Reverse Proxy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container: NGINX on GKE]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Resolves Looker FQDN; rewrites path; forwards to Spoke 2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=none;fontColor=#ffffff;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="950" y="200" width="170" height="100" as="geometry"/></mxCell>
<mxCell id="s1net" value="&lt;b&gt;Spoke 1 VPN / Cloud DNS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container: Networking]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Tunnel to hub; DNS peering zone → Hub DNS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=none;fontColor=#ffffff;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="760" y="330" width="360" height="80" as="geometry"/></mxCell>
<mxCell id="bs2" value="&lt;b&gt;SPOKE 2 VPC — Looker GKE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#444444;dashed=1;strokeWidth=2;fontColor=#444444;fontSize=13;align=left;verticalAlign=bottom;spacingLeft=10;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1180" y="150" width="380" height="300" as="geometry"/></mxCell>
<mxCell id="s2ilb" value="&lt;b&gt;Looker Entry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container: Internal LB]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Cluster ingress for Looker&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=none;fontColor=#ffffff;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1200" y="200" width="160" height="90" as="geometry"/></mxCell>
<mxCell id="looker" value="&lt;b&gt;Looker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container: Looker image on GKE]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Renders partner dashboards&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=none;fontColor=#ffffff;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1380" y="200" width="160" height="90" as="geometry"/></mxCell>
<mxCell id="s2net" value="&lt;b&gt;Spoke 2 VPN / Cloud DNS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container: Networking]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Tunnel to hub; private zone looker.*.internal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=none;fontColor=#ffffff;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1200" y="330" width="340" height="80" as="geometry"/></mxCell>
<mxCell id="apigee" value="&lt;b&gt;Apigee X — Internal Proxy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Fronts ID&amp;A token verification&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=none;fontColor=#ffffff;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="560" y="560" width="220" height="100" as="geometry"/></mxCell>
<mxCell id="ida" value="&lt;b&gt;ID&amp;A Auth API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Verifies JWT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=none;fontColor=#ffffff;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="860" y="560" width="200" height="100" as="geometry"/></mxCell>
<mxCell id="obs" value="&lt;b&gt;Cloud Logging &amp; Monitoring&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Audit + alerting&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=none;fontColor=#ffffff;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1240" y="560" width="240" height="100" as="geometry"/></mxCell>
