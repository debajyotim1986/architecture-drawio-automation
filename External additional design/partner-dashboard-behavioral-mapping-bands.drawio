<mxCell id="title" value="&lt;b&gt;Behavioral View 2 — State Machine: Dashboard Request lifecycle&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#666&quot;&gt;States a single request passes through inside the Looker API, with guards and transitions&lt;/font&gt;" style="text;html=1;fontSize=20;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1200" height="60" as="geometry"/></mxCell>
